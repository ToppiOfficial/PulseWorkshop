<Window x:Class="PulseWorkshop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PulseWorkshop.App.ViewModels"
        xmlns:local="clr-namespace:PulseWorkshop.App"
        Title="PulseWorkshop"
        Height="720" Width="1180" MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVis" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:StringToVisibilityConverter x:Key="StringToVis" />
        <local:FirstLetterConverter x:Key="FirstLetter" />
        <local:PathEllipsisConverter x:Key="PathEllipsis" />
    </Window.Resources>

    <Grid Margin="10,2,10,10">
        <!-- Top-level tabs (the outer container): the Workshop tool, and an About page. The
             Game picker + Connect live inside the Workshop tab - they're Workshop-only; other
             tabs are for tools unrelated to the Steam Workshop connection. The live output console
             is a detached window (ConsoleWindow), toggled with the ~ key - not a drawer here. -->
        <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Padding="0"
                    SelectionChanged="MainTabs_SelectionChanged">
          <!-- Game Setup: standalone config of user-defined games (name, engine, exe/tool paths)
               + shared Steam library folders. Master-detail: a games list on the left, a card-based
               editor on the right. Does not affect the Workshop connection - it's persisted config
               for future tooling. -->
          <TabItem Header="Game Setup">
            <Grid DataContext="{Binding GameSetup}" Margin="0,8,0,0">
              <Grid.Resources>
                <!-- A flat titled section (no own background): the right side is a single gradient
                     panel like the Workshop editor, so sections sit directly on it and just use
                     spacing + a heading to group fields. -->
                <Style x:Key="Card" TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,20" />
                </Style>
                <Style x:Key="CardTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Style>

                <!-- One reusable row for every tool-path field: label | base dropdown | path |
                     Browse | "missing" warning. Bound to a PathFieldViewModel. -->
                <DataTemplate x:Key="PathFieldRow">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding SelectedChoice}"
                                  Margin="0,0,6,0"
                                  ToolTip="Pick a Steam library base, or '(Absolute path)' to type a full path." />
                        <TextBox Grid.Column="2" Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="3" Content="Browse..." Margin="6,0,0,0"
                                Command="{Binding BrowseCommand}" />
                        <TextBlock Grid.Column="4" Text="missing" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource LightDangerBrush}"
                                   ToolTip="The resolved path doesn't exist on disk."
                                   Visibility="{Binding PathMissing, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DataTemplate>
              </Grid.Resources>

              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250" MinWidth="190" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- LEFT: games list with add on top, clone/delete at the bottom -->
              <Border Grid.Column="0" Background="{StaticResource PanelGradientBrush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                      CornerRadius="3" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,2,2,8">
                        <TextBlock Text="Games" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="+" FontSize="18" FontWeight="Bold" Width="26" Height="26" Padding="0"
                                HorizontalAlignment="Right" Command="{Binding AddGameCommand}"
                                ToolTip="Add a new game" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Engine}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource CloneButton}" Click="GameClone_Click"
                                                ToolTip="Clone this game (as 'Clone of ...')." />
                                        <Button Style="{StaticResource TrashButton}" Click="GameDelete_Click"
                                                ToolTip="Delete this game." />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
              </Border>

              <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

              <!-- RIGHT: editor for the selected game - one gradient panel (matching the Workshop
                   editor) with flat titled sections inside. -->
              <Grid Grid.Column="2">
                <TextBlock Text="Select a game on the left, or click + to add one."
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                <Border Background="{StaticResource PanelGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}}">
                  <!-- Scrolls when the window is too short. On a taller window the inner grid's
                       MinHeight tracks the scroll viewport, so the Steam library section still
                       stretches to fill the remaining space (no dead gap at the bottom). -->
                  <ScrollViewer x:Name="GameSetupDetailScroll" VerticalScrollBarVisibility="Auto"
                                Padding="16,14,12,14">
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=GameSetupDetailScroll}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- General -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding SelectedGame.Name, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Engine" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding EngineOptions}"
                                      SelectedItem="{Binding SelectedGame.Engine}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Tools -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="Tools" Style="{StaticResource CardTitle}" />

                        <ContentControl Content="{Binding SelectedGame.GameInfo}"
                                        ContentTemplate="{StaticResource PathFieldRow}" />
                        <ContentControl Content="{Binding SelectedGame.ModelCompiler}"
                                        ContentTemplate="{StaticResource PathFieldRow}" />

                        <!-- Model compiler default options: studiomdl arguments applied to every
                             compile for this game, combined with the per-compile / per-entry options.
                             Columns mirror PathFieldRow so the box lines up under the path textboxes. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="Compiler command" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding SelectedGame.ModelCompilerCommand, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Tag="Default studiomdl options applied to every compile for this game (e.g. -nox360). Empty by default." />
                        </Grid>

                        <ContentControl Content="{Binding SelectedGame.ModelViewer}"
                                        ContentTemplate="{StaticResource PathFieldRow}" />
                        <ContentControl Content="{Binding SelectedGame.PackerTool}"
                                        ContentTemplate="{StaticResource PathFieldRow}" />
                        <ContentControl Content="{Binding SelectedGame.VtfTool}"
                                        ContentTemplate="{StaticResource PathFieldRow}" />

                        <!-- VTF tool launch command: how the Package tool invokes the VTF tool for one
                             image asset. Placeholders are substituted per asset. Columns mirror
                             PathFieldRow so the box lines up under the path textboxes. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="VTF command" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding SelectedGame.VtfToolCommand, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Tag="VTF tool arguments. Placeholders: {input} {output} {outputdir} {outputname}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Steam library folders (stretches to fill the remaining height; bottom margin
                         zeroed so it lines up with the games panel on the left) -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,0">
                      <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Library folders sub-section: Add Library always on top -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Text="Steam Library folders" />
                            <Button HorizontalAlignment="Right" Content="Add Library" Padding="10,3"
                                    Command="{Binding AddLibraryCommand}"
                                    ToolTip="Add a Steam library folder (selectable as a base for any path above)." />
                        </Grid>

                        <!-- The table fills the rest of the card; rows scroll inside it. -->
                        <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8">
                          <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Library path" Style="{StaticResource MutedText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Browse" Style="{StaticResource MutedText}"
                                           FontWeight="SemiBold" Margin="0,0,38,0" />
                            </Grid>

                            <TextBlock Grid.Row="1" Text="No libraries yet - click 'Add Library' above."
                                       Style="{StaticResource MutedText}" Margin="0,2,0,2"
                                       Visibility="{Binding HasLibraries, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                            <ItemsControl Grid.Row="2" VerticalAlignment="Top" ItemsSource="{Binding Libraries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Steam library path (e.g. D:\SteamLibrary)"
                                                     VerticalContentAlignment="Center" />
                                            <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0"
                                                    Command="{Binding BrowseCommand}" />
                                            <Button Grid.Column="2" Style="{StaticResource TrashButton}"
                                                    VerticalAlignment="Center" Margin="2,0,0,0"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove this library." />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </Border>
                      </Grid>
                    </Border>
                    </Grid>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Workshop" x:Name="WorkshopTab">
            <DockPanel Margin="0,8,0,0">
            <!-- Connection bar: game picker + connect (Workshop-only). -->
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGradientBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Game" VerticalAlignment="Center" Margin="0,0,8,0"
                           Style="{StaticResource MutedText}" />
                <ComboBox Grid.Column="1" Width="200" ItemsSource="{Binding Games}"
                          SelectedItem="{Binding SelectedGame}" DisplayMemberPath="DisplayName"
                          VerticalAlignment="Center" />

                <!-- Connect (disconnected) or Disconnect + Launch game (connected) share this slot. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Connect" MinWidth="110"
                            Style="{StaticResource AccentButton}" Command="{Binding ConnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <Button Content="Disconnect" MinWidth="110"
                            Style="{StaticResource DisconnectButton}" Command="{Binding DisconnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                    <!-- Launch game: briefly drops the Steam session so a normal launch isn't blocked,
                         starts the game via Steam, then reconnects - keeping the loaded Workshop list. -->
                    <Button Content="Launch game" MinWidth="110" Margin="8,0,0,0"
                            Style="{StaticResource AccentButton}" Command="{Binding LaunchGameCommand}"
                            ToolTip="Release the Steam session, start the game through Steam, then reconnect - your loaded Workshop list is kept."
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Logged-in Steam user: avatar + persona name + SteamID64, far right. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Border.Clip>
                            <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                        </Border.Clip>
                        <Grid>
                            <!-- Placeholder initial behind the image (shows until/if avatar loads). -->
                            <TextBlock Text="{Binding PersonaName, Converter={StaticResource FirstLetter}}"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Stretch="UniformToFill"
                                   Source="{Binding AvatarUrl, TargetNullValue={x:Null}}"
                                   Visibility="{Binding AvatarUrl, Converter={StaticResource StringToVis}}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PersonaName}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>

            <!-- Resizable top block: main content + action bar share it; the terminal drawer sits below. -->
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main content: lists on the left, editor on the right -->
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Left: separate Published / Drafts / Templates tabs -->
            <Border Grid.Column="0" Background="{StaticResource PanelGradientBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="8">
              <Grid>
                <!-- Tab-strip actions, aligned to the right of the tab headers: Refresh (shown only
                     on the Published tab) + the "+" New item button. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,0,2,0" Panel.ZIndex="1">
                    <Button Content="Refresh" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center"
                            Command="{Binding RefreshPublishedCommand}"
                            Visibility="{Binding IsSelected, ElementName=PublishedTab, Converter={StaticResource BoolToVis}}"
                            ToolTip="Reload the published items from Steam." />
                    <Button Content="+" FontSize="18" FontWeight="Bold" Width="26" Height="26" Padding="0"
                            Command="{Binding NewItemCommand}" ToolTip="New item (creates a draft)" />
                </StackPanel>
                <TabControl x:Name="LeftTabs" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Published" x:Name="PublishedTab">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Search + sort, inline on one row. -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="PublishedSearchBox"
                                         Text="{Binding PublishedSearch, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="SearchBox_KeyDown"
                                         Tag="Search title, tags, description, id..." />
                                <ToggleButton Grid.Column="1" Content=".*" Margin="6,0,0,0" Padding="8,4"
                                              IsChecked="{Binding PublishedRegex}" ToolTip="Regex" />
                                <ComboBox Grid.Column="2" Width="150" Margin="6,0,0,0"
                                          ItemsSource="{Binding PublishedSortOptions}"
                                          SelectedItem="{Binding SelectedPublishedSort}"
                                          ToolTip="Sort the published list." />
                                <ToggleButton Grid.Column="3" Content="Reverse" Margin="6,0,0,0" Padding="8,4"
                                              IsChecked="{Binding PublishedSortReversed}"
                                              ToolTip="Reverse the chosen sort order." />
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding PublishedView}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="PublishedList_SelectionChanged"
                                     x:Name="PublishedList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="56" Height="56" CornerRadius="3"
                                                    Background="{StaticResource PanelAltBrush}">
                                                <Image Stretch="UniformToFill">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{Binding PreviewUrl}" />
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PublishedFileId}" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="  |  " Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{Binding Visibility}" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="  |  " Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{Binding FileSizeDisplay}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}">
                                                    <Run Text="Updated " /><Run Text="{Binding Updated, StringFormat='{}{0:yyyy-MM-dd}', Mode=OneWay}" />
                                                    <Run Text="  -  Published " /><Run Text="{Binding Created, StringFormat='{}{0:yyyy-MM-dd}', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource LinkButton}"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Click="OpenWorkshopItem_Click"
                                                    ToolTip="Open this item on Steam (falls back to your browser)." />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Drafts" x:Name="DraftsTab">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Clears the multi-selection (Ctrl+A selects all). Shown only while something is selected. -->
                                <Button Grid.Column="0" Content="Clear" Padding="8,4" Margin="0,0,6,0"
                                        Click="DraftClearSelection_Click"
                                        Visibility="{Binding HasDraftSelection, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Clear the selected drafts." />
                                <TextBox Grid.Column="1" x:Name="DraftsSearchBox"
                                         Text="{Binding DraftsSearch, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="SearchBox_KeyDown"
                                         Tag="Search drafts..." />
                                <ToggleButton Grid.Column="2" Content=".*" Margin="6,0,0,0" Padding="8,4"
                                              IsChecked="{Binding DraftsRegex}" ToolTip="Regex" />
                                <ComboBox Grid.Column="3" Width="120" Margin="6,0,0,0"
                                          ItemsSource="{Binding DraftSortOptions}"
                                          SelectedItem="{Binding SelectedDraftSort}"
                                          ToolTip="Sort the drafts list." />
                                <ToggleButton Grid.Column="4" Content="Reverse" Margin="6,0,0,0" Padding="8,4"
                                              IsChecked="{Binding DraftSortReversed}"
                                              ToolTip="Reverse the chosen sort order." />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding DraftsView}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Extended"
                                 SelectionChanged="DraftsList_SelectionChanged" x:Name="DraftsList">
                            <!-- Highlighting a row (Ctrl/Shift for several) feeds the bulk publish / delete bar. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="3"
                                                Background="{StaticResource PanelAltBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding ThumbnailSource}"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Modified, StringFormat='Modified {0:g}'}"
                                                       Style="{StaticResource MutedText}" />
                                            <!-- Shown only when the draft edits an existing published item. -->
                                            <TextBlock Text="{Binding WorkshopIdLabel}"
                                                       Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsPublished, Converter={StaticResource BoolToVis}}" />
                                            <!-- Content file path: the directory part trims with an ellipsis while
                                                 the file name stays pinned right, so it reads e.g. c:\docs\...mod.vpk. -->
                                            <DockPanel LastChildFill="True"
                                                       Visibility="{Binding HasContentFile, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="{Binding ContentFilePath}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ContentFileName}"
                                                           Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding ContentFileDirectory}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource MutedText}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource CloneButton}" Click="DraftClone_Click"
                                                    ToolTip="Clone this draft (saves it first, so unsaved edits are copied)." />
                                            <Button Style="{StaticResource TrashButton}" Click="DraftDelete_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Templates" x:Name="TemplatesTab">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TemplatesSearchBox"
                                         Text="{Binding TemplatesSearch, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="SearchBox_KeyDown"
                                         Tag="Search templates..." />
                                <ToggleButton Grid.Column="1" Content=".*" Margin="6,0,0,0" Padding="8,4"
                                              IsChecked="{Binding TemplatesRegex}" ToolTip="Regex" />
                                <ComboBox Grid.Column="2" Width="120" Margin="6,0,0,0"
                                          ItemsSource="{Binding TemplateSortOptions}"
                                          SelectedItem="{Binding SelectedTemplateSort}"
                                          ToolTip="Sort the templates list." />
                                <ToggleButton Grid.Column="3" Content="Reverse" Margin="6,0,0,0" Padding="8,4"
                                              IsChecked="{Binding TemplateSortReversed}"
                                              ToolTip="Reverse the chosen sort order." />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding TemplatesView}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="TemplatesList_SelectionChanged" x:Name="TemplatesList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="3"
                                                Background="{StaticResource PanelAltBrush}">
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding ThumbnailSource}"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Modified, StringFormat='Edited {0:g}'}"
                                                       Style="{StaticResource MutedText}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding DescriptionPreview}" Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Use" Padding="8,2" Margin="0,0,4,0"
                                                VerticalAlignment="Center" Click="TemplateUse_Click"
                                                ToolTip="Start a new item from this template." />
                                        <Button Grid.Column="3" Style="{StaticResource TrashButton}"
                                                VerticalAlignment="Center" Click="TemplateDelete_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
              </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Right: editor. The panel's own border turns Steam blue while a draft or template
                 has unsaved changes (see EditorViewModel.HasUnsavedChanges). -->
            <Border Grid.Column="2" Background="{StaticResource PanelGradientBrush}"
                    BorderThickness="2" CornerRadius="3" Padding="15,7,15,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Editor.HasUnsavedChanges}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource UnsavedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock Text="Select an item, draft, or template - or click New item."
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding Editor, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                    <!-- Editor split into Details + Tags tabs (Tags live on their own tab). -->
                    <TabControl x:Name="EditorTabs" DataContext="{Binding Editor}" Background="Transparent" BorderThickness="0" Padding="0"
                                Visibility="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource NullToVis}}">
                      <TabItem Header="Details">
                        <!-- This tab scrolls so nothing (e.g. Visibility) is cut off on a small window. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
                          <StackPanel>

                        <!-- Title (doubles as the template name in template mode), larger font -->
                        <StackPanel>
                            <TextBlock Text="Title" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="18" Padding="10,8" />
                        </StackPanel>

                        <!-- Description + Change note: side-by-side editors with a drag handle to
                             resize their height (Crowbar-style). The editors live in a fixed-height
                             row that the GridSplitter below grows/shrinks. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="DescRow" Height="220" MinHeight="90" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0">
                                    <TextBlock DockPanel.Dock="Top" Text="Description" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             FontFamily="Consolas" />
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding ChangeNoteLabel}"
                                               Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ChangeNote, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             FontFamily="Consolas" />
                                </DockPanel>
                            </Grid>
                            <!-- Drag down/up to resize the description + change note height. -->
                            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" ResizeBehavior="PreviousAndCurrent"
                                          ResizeDirection="Rows" Background="Transparent"
                                          Cursor="SizeNS" Margin="0,2,0,0" />
                        </Grid>

                        <!-- Visibility + "manage on Steam" shortcuts (placed above Content/Preview so the
                             preview zone has room to scale). Gallery images/videos and required items have
                             no SDK API for these legacy RemoteStorage games, so we deep-link instead. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Visibility" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding VisibilityOptions}"
                                          SelectedItem="{Binding Visibility}" Width="180" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding IsEditingPublished, Converter={StaticResource BoolToVis}}">
                                <Button Content="Images &amp; Videos" Click="OpenManagePreviews_Click"
                                        Margin="0,0,8,0"
                                        ToolTip="Add/edit gallery images and videos for this item on Steam (no SDK API for these games)." />
                                <Button Content="Required Items" Click="OpenManageRequiredItems_Click"
                                        ToolTip="Manage required items for this item on Steam (no SDK API for these games)." />
                            </StackPanel>
                        </Grid>

                        <!-- Content file + Preview image: drag-drop / click-to-browse zones
                             (also shown in template mode - templates can hold content/preview). -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Content file -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,4">
                                    <Run Text="Content file (" /><Run Text="{Binding ContentFileExtension, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                                <!-- Manual path entry; two-way synced with the drop zone and browse dialog.
                                     File mode: a file path. Directory mode (editing a published item with a
                                     known filename): a folder - the published file is auto-picked from it. -->
                                <TextBox Text="{Binding ContentFile, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Type or paste a file path" Margin="0,0,0,6"
                                         Visibility="{Binding UsesDirectoryContentInput, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <TextBox Text="{Binding ContentDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Paste a folder (auto-picks the file) or a full file path" Margin="0,0,0,6"
                                         Visibility="{Binding UsesDirectoryContentInput, Converter={StaticResource BoolToVis}}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <!-- Folder chosen but it lacks the published file: flag it red. -->
                                                <DataTrigger Binding="{Binding ContentDirectoryInvalid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Border x:Name="ContentDrop" Height="250" CornerRadius="3" AllowDrop="True"
                                        Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonUp="ContentDrop_Click"
                                        DragOver="ContentDrop_DragOver" Drop="ContentDrop_Drop">
                                    <Grid>
                                        <!-- Empty: no new file chosen and no published file to describe. -->
                                        <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="10"
                                                   Text="{Binding ContentPlaceholderText}"
                                                   Visibility="{Binding ShowContentPlaceholder, Converter={StaticResource BoolToVis}}" />
                                        <!-- Already-published file (info only; stays unless a new file is chosen). -->
                                        <StackPanel VerticalAlignment="Center" Margin="10"
                                                    Visibility="{Binding ShowPublishedContentInfo, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PublishedContentInfo}"
                                                       ToolTip="{Binding PublishedContentInfo}"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ContentReplaceHint}"
                                                       Style="{StaticResource MutedText}"
                                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <!-- Directory mode: chosen folder lacks the published file. -->
                                        <StackPanel VerticalAlignment="Center" Margin="10"
                                                    Visibility="{Binding ShowContentDirectoryError, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ContentDirectoryError}"
                                                       Foreground="{StaticResource LightDangerBrush}"
                                                       TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock Text="Choose a folder that contains the published file."
                                                       Style="{StaticResource MutedText}"
                                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <!-- New file chosen for upload. -->
                                        <StackPanel VerticalAlignment="Center" Margin="10"
                                                    Visibility="{Binding HasContentFile, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ContentFile, Converter={StaticResource PathEllipsis}}"
                                                       ToolTip="{Binding ContentFile}"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="{Binding ContentFileName, StringFormat='({0})'}"
                                                       Style="{StaticResource MutedText}"
                                                       TextAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ContentFileSizeDisplay}" Style="{StaticResource MutedText}"
                                                       TextAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Preview image -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Preview image" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <!-- Manual path entry; two-way synced with the drop zone and browse dialog. -->
                                <TextBox Text="{Binding PreviewImagePath, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Type or paste an image path" Margin="0,0,0,6" />
                                <Border x:Name="PreviewImageDrop" Height="250" CornerRadius="3" AllowDrop="True"
                                        Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonUp="PreviewDrop_Click"
                                        DragOver="PreviewDrop_DragOver" Drop="PreviewDrop_Drop">
                                    <Grid>
                                        <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="10"
                                                   Text="Drop or click to choose image"
                                                   Visibility="{Binding HasPreviewDisplay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        <Image Source="{Binding PreviewDisplaySource}" Stretch="Uniform" Margin="4"
                                               Visibility="{Binding HasPreviewDisplay, Converter={StaticResource BoolToVis}}" />
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="6"
                                                Background="#AA000000" CornerRadius="3" Padding="6,2"
                                                Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PreviewImageResolution}" Foreground="White" FontSize="11"
                                                           TextAlignment="Right"
                                                           Visibility="{Binding PreviewImageResolution, Converter={StaticResource StringToVis}}" />
                                                <TextBlock Text="{Binding PreviewImageSizeDisplay}" Foreground="White" FontSize="11"
                                                           TextAlignment="Right" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                          </StackPanel>
                        </ScrollViewer>
                      </TabItem>

                      <TabItem Header="Tags">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
                        <!-- Categorized tags (Crowbar-style columns). -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Tags" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding TagGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,24,12" MinWidth="140">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />

                                                <!-- Single-select (e.g. GMod "Type") -->
                                                <ComboBox Width="160" HorizontalAlignment="Left"
                                                          ItemsSource="{Binding TypeOptions}"
                                                          SelectedItem="{Binding SelectedType}"
                                                          Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}" />

                                                <!-- Multi / limited check-list -->
                                                <StackPanel Visibility="{Binding IsCheckList, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding LimitHint}" Style="{StaticResource MutedText}"
                                                               Margin="0,0,0,4"
                                                               Visibility="{Binding LimitHint, Converter={StaticResource NullToVis}}" />
                                                    <ItemsControl ItemsSource="{Binding Tags}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                                          IsEnabled="{Binding IsEnabled}"
                                                                          Foreground="{StaticResource TextBrush}" Margin="0,2" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Always-set (fixed) -->
                                                <ItemsControl ItemsSource="{Binding Tags}"
                                                              Visibility="{Binding IsAlwaysSet, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </DockPanel>
                        </ScrollViewer>
                      </TabItem>

                      <!-- Danger zone: destructive, irreversible actions. Only shown when editing an
                           existing published item (a new item / draft / template has nothing on Steam
                           to delete). -->
                      <TabItem Header="Danger zone"
                               Visibility="{Binding IsEditingPublished, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
                          <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                  CornerRadius="3" Padding="16" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Delete this item" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                           Text="Permanently removes this item from the Steam Workshop. This cannot be undone - subscribers lose access and the Workshop ID is gone for good." />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,0">
                                    <Run Text="Item: " /><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="  -  ID " /><Run Text="{Binding PublishedFileId, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="Delete item permanently" Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" Padding="16,8"
                                        Click="DeletePublished_Click"
                                        IsEnabled="{Binding DataContext.CanDeletePublished, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Permanently delete this item from the Steam Workshop." />
                            </StackPanel>
                          </Border>
                        </ScrollViewer>
                      </TabItem>
                    </TabControl>
                </Grid>
            </Border>
            </Grid>

            <!-- Action bar: sits directly under the editor (terminal drawer is below this block).
                 Indeterminate progress (while busy) on the left, actions on the right. -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PublishRequirementsHint}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding PublishRequirementsHint, Converter={StaticResource StringToVis}}" />
                    <!-- Bulk actions on the highlighted drafts; only surface when more than one is selected. -->
                    <Button Content="Revert selected" Margin="0,0,8,0"
                            Click="DeleteSelectedDrafts_Click"
                            IsEnabled="{Binding CanRunDraftBulkAction}"
                            Visibility="{Binding HasMultipleDraftsSelected, Converter={StaticResource BoolToVis}}"
                            ToolTip="Discard the selected drafts (edits revert to the published item; the Workshop items are NOT deleted)." />
                    <Button Content="{Binding PublishSelectedDraftsText}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                            Click="PublishSelectedDrafts_Click"
                            IsEnabled="{Binding CanRunDraftBulkAction}"
                            Visibility="{Binding HasMultipleDraftsSelected, Converter={StaticResource BoolToVis}}"
                            ToolTip="Publish new items and save edits for all selected drafts." />
                    <Button Content="Save as template" Click="SaveAsTemplate_Click" Margin="0,0,8,0"
                            ToolTip="Save the current tags / description / visibility as a reusable template."
                            Visibility="{Binding CanSaveAsTemplate, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,8,0"
                            ToolTip="Discard this draft and reset to the published item's current state."
                            Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{Binding PrimaryActionText}" Style="{StaticResource AccentButton}"
                            Command="{Binding PublishCommand}"
                            Visibility="{Binding ShowItemActions, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
            </Grid>
            </DockPanel>
          </TabItem>

          <!-- Unpack: browse + export .vpk / .gma archives, or a whole game via gameinfo.txt. -->
          <TabItem Header="Unpack" x:Name="UnpackTab" DataContext="{Binding Unpack}">
            <Grid Margin="0,8,0,4">

              <!-- Nothing open: prompt to pick an archive (or a gameinfo.txt for a full-game mount). -->
              <Border Background="{StaticResource PanelGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="3"
                      Visibility="{Binding IsArchiveOpen, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Unpack" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                               Margin="0,6,0,14" TextAlignment="Center" MaxWidth="480" TextWrapping="Wrap"
                               Text="Open a .vpk package or a .gma addon to browse and export its contents - or open a game's gameinfo.txt to mount every VPK its SearchPaths reference, in engine priority order (for conflicting files the topmost search path wins, exactly as the engine loads them)." />
                    <Button Content="Open package..." Style="{StaticResource AccentButton}"
                            Padding="16,8" HorizontalAlignment="Center" Command="{Binding OpenCommand}" />
                    <!-- Status stays visible after a failed open (the error would otherwise vanish
                         with the loading indicator). -->
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" MaxWidth="480"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <ProgressBar Width="220" IsIndeterminate="True" Margin="0,8,0,0"
                                 HorizontalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </Border>

              <!-- Archive open: header bar + browser + export bar. -->
              <Grid Visibility="{Binding IsArchiveOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: what's open, with Open / Close. -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                        Padding="12,8">
                  <Grid>
                      <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                          <TextBlock Text="{Binding ArchiveName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ArchivePath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                     Style="{StaticResource MutedText}" ToolTip="{Binding ArchivePath}" />
                          <TextBlock Text="{Binding ArchiveSummary}" Style="{StaticResource MutedText}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="Open" Padding="10,4" Command="{Binding OpenCommand}" />
                          <Button Content="Close" Margin="6,0,0,0" Padding="10,4" Command="{Binding CloseCommand}" />
                      </StackPanel>
                  </Grid>
                </Border>

                <!-- Browser: folder tree on the left, files of the selected folder on the right. -->
                <Border Grid.Row="1" Margin="0,8,0,0" Background="{StaticResource PanelGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                  <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="200" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: folder tree. -->
                    <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="6">
                      <TreeView x:Name="UnpackTree" ItemsSource="{Binding TreeRoots}"
                                SelectedItemChanged="UnpackTree_SelectedItemChanged"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <TreeView.ItemContainerStyle>
                              <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                              </Style>
                          </TreeView.ItemContainerStyle>
                          <TreeView.ItemTemplate>
                              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                  <StackPanel Orientation="Horizontal">
                                      <!-- Per-folder context menu (in the template, not the
                                           ItemContainerStyle: Click handlers in a Style setter break
                                           WPF's connection-ID wiring). -->
                                      <StackPanel.ContextMenu>
                                          <ContextMenu Style="{StaticResource DarkContextMenu}">
                                              <MenuItem Header="Export folder..." Style="{StaticResource DarkMenuItem}"
                                                        Click="UnpackExportFolderMenu_Click"
                                                        ToolTip="Export this folder and all its subfolders to disk, recreating the folder structure." />
                                          </ContextMenu>
                                      </StackPanel.ContextMenu>
                                      <!-- Folder glyph -->
                                      <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                            Fill="{StaticResource MutedTextBrush}" Stretch="Uniform"
                                            Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis" />
                                      <TextBlock Text="{Binding TotalFileCount, StringFormat=' ({0:N0})'}"
                                                 Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                  </StackPanel>
                              </HierarchicalDataTemplate>
                          </TreeView.ItemTemplate>
                      </TreeView>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                    <!-- RIGHT: filter + column header ribbon + file list. -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search (updates shortly after you stop typing; Enter searches now)"
                                     KeyDown="UnpackFilter_KeyDown"
                                     ToolTip="Search over the scope on the right - plain substring, or a regex when .* is on. Results refresh shortly after typing pauses - press Enter to search immediately. Clear to go back to folder browsing."
                                     VerticalContentAlignment="Center" />
                            <ToggleButton Grid.Column="1" Content=".*" Margin="6,0,0,0" Padding="8,4"
                                          IsChecked="{Binding FilterRegex}"
                                          ToolTip="Treat the search as a regex (case-insensitive). Off = plain substring match." />
                            <ComboBox Grid.Column="2" Width="110" Margin="6,0,0,0"
                                      ItemsSource="{Binding SearchScopes}"
                                      SelectedItem="{Binding SelectedSearchScope}"
                                      ToolTip="Search scope - Current: only the selected folder's own files. Recursive: the selected folder and all its subfolders. Global: every file in the package." />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding FileListCaption}" Style="{StaticResource MutedText}"
                                   Margin="2,6,2,4" TextTrimming="CharacterEllipsis" />

                        <!-- Clickable column-header ribbon (Explorer-style): click to sort, click again
                             to reverse. Column widths match the row template below. The right margin
                             leaves room for the list's scrollbar so headers line up with the cells. -->
                        <Border Grid.Row="2" Margin="2,0,13,2" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ColumnHeaderButton}"
                                    Tag="Type" Click="UnpackSort_Click" ToolTip="Sort by file type">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Type" />
                                    <TextBlock Text="{Binding SortGlyphType}" Margin="3,0,0,0" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}"
                                    Tag="Name" Click="UnpackSort_Click" ToolTip="Sort by name">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Name" />
                                    <TextBlock Text="{Binding SortGlyphName}" Margin="3,0,0,0" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}"
                                    Tag="Source" Click="UnpackSort_Click" ToolTip="Sort by pack (the .vpk/.gma it belongs to)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pack" />
                                    <TextBlock Text="{Binding SortGlyphSource}" Margin="3,0,0,0" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}"
                                    Tag="Size" Click="UnpackSort_Click" ToolTip="Sort by file size"
                                    HorizontalContentAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Size" />
                                    <TextBlock Text="{Binding SortGlyphSize}" Margin="3,0,0,0" FontSize="9" />
                                </StackPanel>
                            </Button>
                          </Grid>
                        </Border>

                        <ListBox x:Name="UnpackFiles" Grid.Row="3" ItemsSource="{Binding Files}"
                                 SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 MouseDoubleClick="UnpackFiles_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="UnpackFiles_PreviewMouseRightButtonDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <!-- Per-row context menu (defined in the template, not the
                                             ItemContainerStyle: Click handlers inside a Style setter
                                             break WPF's connection-ID wiring). ItemContainerStyle is
                                             set explicitly because implicit styles don't reach a
                                             ContextMenu nested in a DataTemplate at runtime - without
                                             it the items fall back to the default light template. -->
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                                <MenuItem Header="Export selected..." Style="{StaticResource DarkMenuItem}"
                                                          Click="UnpackExportMenu_Click" />
                                                <MenuItem Header="Go to file" Style="{StaticResource DarkMenuItem}"
                                                          Click="UnpackGoToMenu_Click"
                                                          ToolTip="Clear the search and open the folder that contains this file." />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Extension chip (files) / folder glyph (subfolder rows) -->
                                        <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                                                CornerRadius="3" Padding="4,1" Margin="0,0,8,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <TextBlock Text="{Binding TypeDisplay}" FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </Border>
                                        <Path Grid.Column="0" Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                              Fill="{StaticResource MutedTextBrush}" Stretch="Uniform"
                                              Width="13" Height="13" Margin="2,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <!-- Providing archive: which VPK won for a gameinfo mount. -->
                                        <TextBlock Grid.Column="2" Text="{Binding Source}" Margin="8,0"
                                                   Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" TextAlignment="Right"
                                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                  </Grid>
                </Border>

                <!-- Export action + status. A folder can also be exported from the tree's context menu;
                     this button exports the highlighted file rows (or the selected folder if none). -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding ExportButtonLabel}" Style="{StaticResource AccentButton}" MinWidth="130"
                                Padding="16,8" Command="{Binding ExportSelectedCommand}"
                                ToolTip="Exports the active selection: highlighted file rows (Ctrl/Shift multi-select), or - with nothing highlighted - the folder selected in the tree, recursively." />
                        <Button Content="Cancel" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                Padding="14,8" Command="{Binding CancelExportCommand}"
                                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4" MaxWidth="520" />
                            <ProgressBar Width="220" Value="{Binding ExportProgress, Mode=OneWay}"
                                         Maximum="100" HorizontalAlignment="Left"
                                         Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
              </Grid>
            </Grid>
          </TabItem>

          <!-- Compile: a friendlier take on Crowbar's "Compile MDL". An inner Simple / Advanced
               tab split (Advanced is a placeholder for now). Runs studiomdl on a single .qc using a
               Game Setup entry's tool paths, streaming live output into the bottom Terminal drawer. -->
          <TabItem Header="Compile" x:Name="CompileTab">
            <Grid DataContext="{Binding Compile}" Margin="0,8,0,0">
              <Grid.Resources>
                <!-- The left-hand label of a form row: muted, aligned to its field's text line.
                     Min width keeps the field column's left edge consistent across rows. -->
                <Style x:Key="CompileFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="MinWidth" Value="60" />
                    <Setter Property="Margin" Value="0,6,12,0" />
                </Style>
              </Grid.Resources>

              <TabControl x:Name="CompileTabs" Background="Transparent" BorderThickness="0" Padding="0">

                <!-- SIMPLE: the working compile form. Live studiomdl output goes to the detached
                     console window (~), so there's no embedded terminal here anymore. -->
                <TabItem Header="Simple" x:Name="CompileSimpleTab">
                  <Grid Margin="0,8,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="100" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                  <Border Grid.Row="0" Background="{StaticResource PanelGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Game: full-width dropdown (from the Game Setup roster). -->
                        <TextBlock Grid.Row="0" Text="Game" Style="{StaticResource CompileFieldLabel}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                  ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                  DisplayMemberPath="DisplayName" />

                        <!-- Resolved compiler + gameinfo paths (with "missing" warnings). -->
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                              Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Compiler" Style="{StaticResource MutedText}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedGame.ModelCompiler.ResolvedPath}"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}"
                                       ToolTip="{Binding SelectedGame.ModelCompiler.ResolvedPath}" />
                            <TextBlock Grid.Column="2" Text="missing" Margin="8,0,0,0"
                                       Foreground="{StaticResource LightDangerBrush}"
                                       ToolTip="The model compiler path doesn't exist - set it in Game Setup."
                                       Visibility="{Binding SelectedGame.ModelCompiler.PathMissing, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Row="1" Text="GameInfo" Style="{StaticResource MutedText}" Margin="0,3,10,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGame.GameInfo.ResolvedPath}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}"
                                       ToolTip="{Binding SelectedGame.GameInfo.ResolvedPath}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="missing" Margin="8,3,0,0"
                                       Foreground="{StaticResource LightDangerBrush}"
                                       ToolTip="The gameinfo.txt path doesn't exist - set it in Game Setup."
                                       Visibility="{Binding SelectedGame.GameInfo.PathMissing, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <!-- QC file: full-width path + Browse. -->
                        <TextBlock Grid.Row="2" Text="QC file" Style="{StaticResource CompileFieldLabel}" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding QcPath, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Type or paste a .qc path" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Open file" Margin="6,0,0,0"
                                    Command="{Binding OpenQcCommand}"
                                    ToolTip="Open the .qc in the OS default editor." />
                            <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0"
                                    Command="{Binding BrowseQcCommand}" />
                        </Grid>

                        <!-- Output: mode dropdown inline with its field (Subfolder name / Work folder path). -->
                        <TextBlock Grid.Row="3" Text="Output" Style="{StaticResource CompileFieldLabel}" />
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Width="220" ItemsSource="{Binding OutputModes}"
                                      SelectedItem="{Binding SelectedOutputMode}" />
                            <!-- One of these two occupies the field cell, depending on the mode. -->
                            <TextBox Grid.Column="1" Margin="6,0,0,0"
                                     Text="{Binding SubfolderName, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Visibility="{Binding ShowSubfolderName, Converter={StaticResource BoolToVis}}"
                                     ToolTip="Folder created beside the .qc to receive the compiled files (preserving the models\... path)." />
                            <TextBox Grid.Column="1" Margin="6,0,0,0"
                                     Text="{Binding WorkFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Absolute path to copy compiled files into" VerticalContentAlignment="Center"
                                     Visibility="{Binding ShowWorkFolder, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0"
                                    Command="{Binding BrowseWorkFolderCommand}"
                                    Visibility="{Binding ShowWorkFolder, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <!-- Options: full-width. -->
                        <TextBlock Grid.Row="4" Text="Options" Style="{StaticResource CompileFieldLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding ExtraOptions, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Extra studiomdl options (e.g. -nox360)" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                   TextWrapping="Wrap"
                                   Text="-verbose is always added (its output locates the .mdl); a typed -quiet is removed automatically." />

                        <!-- Command preview: full-width, read-only. -->
                        <TextBlock Grid.Row="6" Text="Command" Style="{StaticResource CompileFieldLabel}" />
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,12"
                                 Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 Background="{StaticResource BgBrush}" />

                        <!-- Compile action + status (left) + material options (far right). -->
                        <Grid Grid.Row="7" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Compile" Style="{StaticResource AccentButton}" MinWidth="120"
                                        Padding="16,8" Command="{Binding CompileCommand}" />
                                <Button Content="Go to file" Command="{Binding GoToMdlCommand}"
                                        Margin="8,0,0,0" Padding="12,8"
                                        Visibility="{Binding LastMdlPath, Converter={StaticResource StringToVis}}"
                                        ToolTip="{Binding LastMdlPath}" />
                                <Button Content="View Model" Command="{Binding ViewModelCommand}"
                                        Margin="8,0,0,0" Padding="12,8"
                                        Visibility="{Binding LastMdlPath, Converter={StaticResource StringToVis}}"
                                        ToolTip="Send the compiled model to the Model View tab (does not open the viewer)." />
                                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                    <ProgressBar Width="200" IsIndeterminate="True" HorizontalAlignment="Left"
                                                 Visibility="{Binding IsCompiling, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Material options: all on one line. Localize + Flat patch are always
                                 visible but disabled until "Get materials on compile" is checked. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Get materials on compile"
                                          IsChecked="{Binding GetMaterialOnCompile}"
                                          IsEnabled="{Binding CanGetMaterials}"
                                          Foreground="{StaticResource TextBrush}"
                                          ToolTip="After each successful compile, copy VMT and VTF files to the output folder. Requires Subfolder or Work folder output mode." />
                                <CheckBox Content="Localize" IsChecked="{Binding LocalizeMaterials}"
                                          IsEnabled="{Binding CanConfigureMaterials}"
                                          Margin="14,0,0,0" Foreground="{StaticResource TextBrush}"
                                          ToolTip="Place VTF files beside their VMT instead of preserving the game's materials hierarchy." />
                                <CheckBox Content="Flat patch" IsChecked="{Binding FlatPatchShader}"
                                          IsEnabled="{Binding CanConfigureMaterials}"
                                          Margin="14,0,0,0" Foreground="{StaticResource TextBrush}"
                                          ToolTip="Flatten Patch VMTs into their base shader." />
                            </StackPanel>
                        </Grid>

                      </Grid>
                    </ScrollViewer>
                  </Border>

                  <!-- Post-compile: the info box shows the compiled model's stats ("Go to file",
                       which opens Explorer with the .mdl selected, lives in the bottom action bar).
                       Always shown (empty until compiled); the box fills the remaining space and
                       scrolls when the text overflows. -->
                  <Grid Grid.Row="1" Margin="0,10,0,0">
                      <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                          <TextBlock Text="Model info" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBox Grid.Row="1" Text="{Binding MdlInfo, Mode=OneWay}" IsReadOnly="True"
                               TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                  </Grid>
                  </Grid>
                </TabItem>

                <!-- ADVANCED: a project-directory workflow. State lives in a .pw_mdlproject file the
                     user picks; it owns its own game selection and an ordered, drag-reorderable list
                     of model entries compiled one at a time. DataContext is the Window's
                     CompileAdvanced VM (the inner TabControl's DataContext is the Simple Compile VM). -->
                <TabItem Header="Advanced" x:Name="CompileAdvancedTab"
                         DataContext="{Binding DataContext.CompileAdvanced, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Grid Margin="0,8,0,4">

                    <!-- No project open: prompt to create or open one. -->
                    <Border Background="{StaticResource PanelGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="Advanced compile" FontSize="15" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" />
                          <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                     Margin="0,6,0,14" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                                     Text="Create or open a model project (.pw_mdlproject). It stores its own game, entries and options in the folder you choose." />
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                              <Button Content="New project..." Style="{StaticResource AccentButton}"
                                      Padding="16,8" Command="{Binding NewProjectCommand}" />
                              <Button Content="Open project..." Margin="8,0,0,0" Padding="16,8"
                                      Command="{Binding OpenProjectCommand}" />
                          </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- Project open: bar + settings (top), the entries list (with its compile-all
                         action bar) fills the rest. Live output goes to the detached console (~). -->
                    <Grid Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}}">
                      <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" MinHeight="160" />
                      </Grid.RowDefinitions>

                      <!-- Project bar: name + path, with New / Open / Close. -->
                      <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                              Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProjectPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Style="{StaticResource MutedText}" ToolTip="{Binding ProjectPath}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="New" Padding="10,4" Command="{Binding NewProjectCommand}" />
                                <Button Content="Open" Margin="6,0,0,0" Padding="10,4" Command="{Binding OpenProjectCommand}" />
                                <Button Content="Close" Margin="6,0,0,0" Padding="10,4" Command="{Binding CloseProjectCommand}" />
                            </StackPanel>
                        </Grid>
                      </Border>

                      <!-- Project settings: game, global command, material + clean options. -->
                      <Border Grid.Row="1" Margin="0,8,0,0" Background="{StaticResource PanelGradientBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel Margin="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Game" Style="{StaticResource CompileFieldLabel}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                          ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                          DisplayMemberPath="DisplayName" />

                                <TextBlock Grid.Row="1" Text="Global" Style="{StaticResource CompileFieldLabel}" />
                                <!-- Multi-line, user-resizable: drag the handle below to set its height. -->
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBox x:Name="GlobalCommandBox" Height="50" MinHeight="34"
                                             Text="{Binding GlobalCommand, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             Tag="studiomdl options shared by every entry. You can use line breaks to organize them - they're flattened to spaces when compiling." />
                                    <Thumb Height="9" Cursor="SizeNS" HorizontalAlignment="Stretch"
                                           DragDelta="GlobalCommandResize_DragDelta" ToolTip="Drag to resize.">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent" Padding="0,3">
                                                    <Border Height="2" Width="44" CornerRadius="1"
                                                            HorizontalAlignment="Center"
                                                            Background="{StaticResource BorderBrush}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </StackPanel>
                            </Grid>

                            <!-- Two side-by-side option groups (they share the wide row instead of
                                 stacking, to save vertical space): material copy on the left, the
                                 independent build-transfer toggles on the right. -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: materials group. The master toggle owns the copy sub-options
                                     nested beneath it (indented + greyed until it's on). -->
                                <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="12,10">
                                    <StackPanel>
                                        <CheckBox Content="Get materials on compile" IsChecked="{Binding GetMaterialOnCompile}"
                                                  FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                  ToolTip="After each successful compile (that moves output out of game), copy VMT and VTF files to the output folder." />

                                        <!-- Copy sub-options: whole block greys out until the master is on. -->
                                        <StackPanel Margin="24,8,0,0" IsEnabled="{Binding CanConfigureMaterials}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="Localize" IsChecked="{Binding LocalizeMaterials}"
                                                          Foreground="{StaticResource TextBrush}"
                                                          ToolTip="Place VTF files beside their VMT instead of preserving the game's materials hierarchy." />
                                                <CheckBox Content="Flat patch" IsChecked="{Binding FlatPatchShader}"
                                                          Margin="18,0,0,0" Foreground="{StaticResource TextBrush}"
                                                          ToolTip="Flatten Patch VMTs into their base shader." />
                                            </StackPanel>

                                            <!-- Optional dedicated materials folder: when checked, the materials/
                                                 tree is written here (always relative to the project root) instead
                                                 of beside the compiled models. Outside-project paths are rejected. -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Content="Custom materials folder"
                                                          IsChecked="{Binding UseCustomMaterialsDir}"
                                                          VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                                          ToolTip="Put the materials/ folder in a dedicated folder under the project root instead of beside the compiled models." />
                                                <TextBox Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                                                         Text="{Binding MaterialsOutputDir, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CanEditMaterialsDir}"
                                                         ToolTip="Folder relative to the project root (e.g. shared/materials_src). Absolute or outside-project paths are not allowed; empty means the project root." />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- RIGHT: build-transfer group, independent of the material copy. -->
                                <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                        Padding="12,10">
                                    <StackPanel>
                                        <CheckBox Content="Clean before transfer" IsChecked="{Binding CleanBeforeTransfer}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  ToolTip="Before a non-in-game compile, delete the previous in-game build so stale files can't leak into the moved output." />

                                        <CheckBox Content="Make material's directory" IsChecked="{Binding MakeMaterialDir}"
                                                  Margin="0,8,0,0" Foreground="{StaticResource TextBrush}"
                                                  ToolTip="After an in-game compile, create the model's material folders (from its $cdmaterials paths) under the game's materials/ folder - handy for a fresh, untextured model. Non-in-game compiles do nothing." />

                                        <!-- Which game root the empty material folders are created under: gameinfo.txt
                                             can mount several content roots. Shown only while the toggle above is on. -->
                                        <Grid Margin="24,8,0,0"
                                              Visibility="{Binding MakeMaterialDir, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Material root:" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                      ItemsSource="{Binding MaterialGameRoots}"
                                                      SelectedItem="{Binding SelectedMaterialGameRoot}"
                                                      ToolTip="{Binding SelectedMaterialGameRoot}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                      </Border>

                      <!-- Model entries: a master-detail layout (entries sidebar + selected-entry
                           editor, like Game Setup / Package) plus the compile-all action bar at the
                           bottom (kept inside this panel so the drag handle below sits directly
                           between the list and the terminal). -->
                      <Border Grid.Row="2" Margin="0,8,0,0" Background="{StaticResource PanelGradientBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <Grid Margin="14,10">
                          <Grid.RowDefinitions>
                              <RowDefinition Height="*" />
                              <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <!-- Master-detail: entries sidebar (left) + selected-entry editor (right),
                               like Game Setup. The sidebar shows the entry name + which .qc it uses. -->
                          <Grid Grid.Row="0">
                              <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="340" MinWidth="230" />
                                  <ColumnDefinition Width="8" />
                                  <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>

                              <!-- LEFT: entries list. Add on top; drag the handle to reorder. -->
                              <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                      CornerRadius="3" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="2,2,2,8">
                                        <TextBlock Text="Entries" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Content="+" FontSize="18" FontWeight="Bold" Width="26" Height="26" Padding="0"
                                                HorizontalAlignment="Right" Command="{Binding AddEntryCommand}"
                                                ToolTip="Add a QC file to compile" />
                                    </Grid>

                                    <ListBox x:Name="AdvancedEntriesList" Grid.Row="1" ItemsSource="{Binding Entries}"
                                             SelectedItem="{Binding SelectedEntry}" SelectionMode="Extended"
                                             HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                             PreviewMouseLeftButtonDown="AdvancedEntries_PreviewMouseLeftButtonDown"
                                             DragOver="AdvancedEntries_DragOver" Drop="AdvancedEntries_Drop" AllowDrop="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <!-- Highlighting a row (Ctrl/Shift for several) feeds "Compile selected". -->
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Drag handle (only this initiates a reorder drag) -->
                                                    <TextBlock Grid.Column="0" Tag="DragHandle" Text="&#x2630;" FontSize="14"
                                                               Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}" Cursor="SizeNS"
                                                               ToolTip="Drag to reorder" />
                                                    <!-- Quick 'Compile all' toggle, editable straight from the list. -->
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding CompileInAll}" VerticalAlignment="Center"
                                                              Margin="0,0,8,0" Foreground="{StaticResource TextBrush}"
                                                              ToolTip="Include this entry when 'Compile all' runs." />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding QcSummary}" Style="{StaticResource MutedText}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ResolvedQcPath}" />
                                                    </StackPanel>
                                                    <!-- Output-destination badge: Subfolder vs in-game (no move). -->
                                                    <Border Grid.Column="3" Margin="6,0,0,0" Padding="5,0" CornerRadius="8" BorderThickness="1"
                                                            VerticalAlignment="Center" ToolTip="{Binding OutputModeTooltip}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowSubfolder}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding OutputModeLabel}" FontSize="9">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowSubfolder}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <!-- Status dot: blue while compiling, red after a failed compile. -->
                                                    <Ellipse Grid.Column="4" Width="8" Height="8" Margin="4,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCompiling}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CloneButton}" Command="{Binding CloneCommand}"
                                                                ToolTip="Duplicate this entry." />
                                                        <Button Style="{StaticResource TrashButton}" Command="{Binding RemoveCommand}"
                                                                ToolTip="Remove this entry." />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                              </Border>

                              <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                              <!-- RIGHT: editor for the selected entry. -->
                              <Grid Grid.Column="2">
                                  <TextBlock Text="Select an entry on the left, or click + to add a QC file."
                                             Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                  <ContentControl Content="{Binding SelectedEntry}">
                                    <ContentControl.ContentTemplate>
                                      <DataTemplate>
                                        <DataTemplate.Resources>
                                            <Style x:Key="EntryLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="MinWidth" Value="56" />
                                                <Setter Property="Margin" Value="0,0,8,0" />
                                            </Style>
                                        </DataTemplate.Resources>
                                        <!-- Outline reflects state: blue while compiling, red if the last
                                             compile failed (red persists until the next compile / restart). -->
                                        <Border CornerRadius="3" Padding="12" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{StaticResource DangerColor}"
                                                                                      BlurRadius="9" ShadowDepth="0" Opacity="0.7" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCompiling}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{StaticResource AccentColor}"
                                                                                      BlurRadius="9" ShadowDepth="0" Opacity="0.85" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <!-- Scrolls when the pane is too short to show the whole form; the grid's
                                                 MinHeight tracks the viewport so the Model info '*' row still fills the
                                                 space when there's room. -->
                                            <ScrollViewer x:Name="CompileEntryScroll" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                            <Grid MinHeight="{Binding ViewportHeight, ElementName=CompileEntryScroll}">
                                              <Grid.RowDefinitions>
                                                  <RowDefinition Height="Auto" />
                                                  <RowDefinition Height="*" />
                                              </Grid.RowDefinitions>
                                              <StackPanel Grid.Row="0">
                                                  <CheckBox Content="Include in &quot;Compile all&quot;" Margin="0,0,0,8"
                                                            IsChecked="{Binding CompileInAll}" Foreground="{StaticResource TextBrush}"
                                                            ToolTip="Include this entry when the bottom 'Compile all' button runs." />

                                                  <!-- Name ("Go to file" lives in the bottom action bar). -->
                                                  <Grid>
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Text="Name" Style="{StaticResource EntryLabel}" />
                                                      <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                               Tag="Entry name" VerticalContentAlignment="Center" />
                                                  </Grid>

                                                  <!-- QC + Browse -->
                                                  <Grid Margin="0,8,0,0">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="Auto" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Grid.Column="0" Text="QC" Style="{StaticResource EntryLabel}" />
                                                      <TextBox Grid.Column="1" Text="{Binding QcPath, UpdateSourceTrigger=PropertyChanged}"
                                                               Tag="Path to .qc (relative to the project, or absolute)"
                                                               VerticalContentAlignment="Center" ToolTip="{Binding ResolvedQcPath}" />
                                                      <Button Grid.Column="2" Content="Open file" Margin="6,0,0,0"
                                                              Command="{Binding OpenQcCommand}"
                                                              ToolTip="Open the .qc in the OS default editor." />
                                                      <Button Grid.Column="3" Content="Browse..." Margin="6,0,0,0"
                                                              Command="{Binding BrowseQcCommand}" />
                                                  </Grid>

                                                  <!-- Output destination: subfolder name + mode -->
                                                  <Grid Margin="0,8,0,0">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                          <ColumnDefinition Width="Auto" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Grid.Column="0" Text="Output" Style="{StaticResource EntryLabel}" />
                                                      <TextBox Grid.Column="1"
                                                               Text="{Binding SubfolderName, UpdateSourceTrigger=PropertyChanged}"
                                                               IsEnabled="{Binding ShowSubfolder}"
                                                               ToolTip="Subfolder under the project (a nested path like test/bill is allowed). Disabled for 'Compile in game'."
                                                               VerticalContentAlignment="Center" />
                                                      <ComboBox Grid.Column="2" Width="200" Margin="6,0,0,0"
                                                                ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}" />
                                                  </Grid>

                                                  <!-- Per-entry command -->
                                                  <Grid Margin="0,8,0,0">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Text="Command" Style="{StaticResource EntryLabel}" />
                                                      <TextBox Grid.Column="1" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                                               Tag="Extra studiomdl options for this entry (appended after the global command)"
                                                               VerticalContentAlignment="Center" />
                                                  </Grid>

                                                  <!-- Command preview: the exact studiomdl line (global + entry command), read-only. -->
                                                  <Grid Margin="0,8,0,0">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Text="Preview" Style="{StaticResource EntryLabel}" />
                                                      <TextBox Grid.Column="1" Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True"
                                                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                                               Background="{StaticResource BgBrush}"
                                                               ToolTip="The exact studiomdl command line this entry will run (global command + entry command)." />
                                                  </Grid>

                                              </StackPanel>

                                              <!-- MDL info: populated after a successful compile (same trigger as "Go to file").
                                                   Always shown (empty until compiled); fills the remaining space and scrolls when the text overflows. -->
                                              <Grid Grid.Row="1" Margin="0,12,0,0">
                                                  <Grid.RowDefinitions>
                                                      <RowDefinition Height="Auto" />
                                                      <RowDefinition Height="*" />
                                                  </Grid.RowDefinitions>
                                                  <TextBlock Text="Model info" Style="{StaticResource EntryLabel}" Margin="0,0,0,4" />
                                                  <TextBox Grid.Row="1" MinHeight="140" Text="{Binding MdlInfo, Mode=OneWay}" IsReadOnly="True"
                                                           TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                                                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                              </Grid>
                                            </Grid>
                                            </ScrollViewer>
                                        </Border>
                                      </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                  </ContentControl>
                              </Grid>
                          </Grid>

                          <!-- Compile all + status, with the terminal toggle on the right. -->
                          <Grid Grid.Row="1" Margin="0,10,0,0">
                              <StackPanel Orientation="Horizontal">
                                  <Button Content="Compile all" Style="{StaticResource AccentButton}" MinWidth="120"
                                          Padding="16,8" Command="{Binding CompileAllCommand}"
                                          ToolTip="Compile every entry with its 'Compile all' box ticked." />
                                  <Button Content="Compile selected" MinWidth="120" Margin="8,0,0,0"
                                          Padding="16,8" Command="{Binding CompileSelectedCommand}"
                                          ToolTip="Compile the highlighted entries (select several with Ctrl/Shift)." />
                                  <Button Content="Go to file" Margin="8,0,0,0" Padding="12,8"
                                          Command="{Binding SelectedEntry.GoToMdlCommand}"
                                          Visibility="{Binding SelectedEntry.LastMdlPath, Converter={StaticResource StringToVis}}"
                                          ToolTip="{Binding SelectedEntry.LastMdlPath}" />
                                  <Button Content="View Model" Margin="8,0,0,0" Padding="12,8"
                                          Command="{Binding SelectedEntry.ViewModelCommand}"
                                          Visibility="{Binding SelectedEntry.LastMdlPath, Converter={StaticResource StringToVis}}"
                                          ToolTip="Send the compiled model to the Model View tab (does not open the viewer)." />
                                  <Button Content="Go to Materials" Margin="8,0,0,0" Padding="12,8"
                                          Command="{Binding SelectedEntry.GoToMaterialsCommand}"
                                          Visibility="{Binding SelectedEntry.HasMaterialDirs, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Open the model's material folder created under the game's materials/ directory." />
                                  <!-- Picker: only shown when the model has more than one material folder. -->
                                  <ComboBox Margin="6,0,0,0" MinWidth="170" VerticalAlignment="Center"
                                            ItemsSource="{Binding SelectedEntry.MaterialDirs}"
                                            SelectedItem="{Binding SelectedEntry.SelectedMaterialDir}"
                                            Visibility="{Binding SelectedEntry.HasMultipleMaterialDirs, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Choose which material folder 'Go to Materials' opens." />
                                  <Button Content="Cancel" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                          Padding="14,8" Command="{Binding CancelCommand}"
                                          Visibility="{Binding IsCompiling, Converter={StaticResource BoolToVis}}" />
                                  <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                                 TextTrimming="CharacterEllipsis" Margin="0,0,0,4" MaxWidth="420" />
                                      <ProgressBar Width="200" IsIndeterminate="True" HorizontalAlignment="Left"
                                                   Visibility="{Binding IsCompiling, Converter={StaticResource BoolToVis}}" />
                                  </StackPanel>
                              </StackPanel>
                          </Grid>
                        </Grid>
                      </Border>
                    </Grid>
                  </Grid>
                </TabItem>

              </TabControl>
            </Grid>
          </TabItem>

          <!-- Package: pack a content folder into a .vpk/.gma via the game's packer. An inner
               Simple / Advanced split (Advanced first). Advanced shares the .pw_mdlproject with the
               Compile tab but edits its own entry list; each entry bakes its pre-assets into the
               folder, then runs the packer, streaming output into the bottom Terminal drawer. -->
          <TabItem Header="Package" x:Name="PackageTab">
            <Grid Margin="0,8,0,0">
              <Grid.Resources>
                <!-- Same form-row label as the Compile tab (scoped per tab). -->
                <Style x:Key="CompileFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="MinWidth" Value="60" />
                    <Setter Property="Margin" Value="0,6,12,0" />
                </Style>
              </Grid.Resources>
              <TabControl x:Name="PackageTabs" Background="Transparent" BorderThickness="0" Padding="0">

                <!-- SIMPLE: pack one folder into a single .vpk/.gma. Live packer output goes to the
                     detached console window (~), mirroring Compile - Simple. DataContext is the
                     Package (Simple) VM. -->
                <TabItem Header="Simple" x:Name="PackageSimpleTab" DataContext="{Binding Package}">
                  <Border Background="{StaticResource PanelGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="3" Margin="0,8,0,4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,12">
                      <Grid VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Game: full-width dropdown (from the Game Setup roster). -->
                        <TextBlock Grid.Row="0" Text="Game" Style="{StaticResource CompileFieldLabel}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                  ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                  DisplayMemberPath="DisplayName" />

                        <!-- Resolved packer path (with a "missing" warning). -->
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                              Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Packer" Style="{StaticResource MutedText}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedGame.PackerTool.ResolvedPath}"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}"
                                       ToolTip="{Binding SelectedGame.PackerTool.ResolvedPath}" />
                            <TextBlock Grid.Column="2" Text="missing" Margin="8,0,0,0"
                                       Foreground="{StaticResource LightDangerBrush}"
                                       ToolTip="The packer tool path doesn't exist - set it in Game Setup."
                                       Visibility="{Binding SelectedGame.PackerTool.PathMissing, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <!-- Folder to package: full-width path + Open/Browse. -->
                        <TextBlock Grid.Row="2" Text="Folder" Style="{StaticResource CompileFieldLabel}" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Type or paste the folder to pack" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Open folder" Margin="6,0,0,0"
                                    Command="{Binding OpenFolderCommand}"
                                    ToolTip="Open the folder in Explorer." />
                            <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0"
                                    Command="{Binding BrowseFolderCommand}" />
                        </Grid>

                        <!-- Output name: optional override for the produced package's file name. -->
                        <TextBlock Grid.Row="3" Text="Output name" Style="{StaticResource CompileFieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Optional - leave blank to keep the folder name" VerticalContentAlignment="Center"
                                 ToolTip="Rename the produced .vpk/.gma to this. The packer's extension is kept when omitted; blank keeps the folder name." />

                        <!-- Options: full-width. -->
                        <TextBlock Grid.Row="4" Text="Options" Style="{StaticResource CompileFieldLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                                 Text="{Binding ExtraOptions, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Extra packer options" VerticalContentAlignment="Center"
                                 ToolTip="Passed straight to the packer (vpk options precede the folder; gmad args follow create)." />

                        <!-- Packer flags: shown per packer type (vpk vs gmad). "Write log" applies to both. -->
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox Content="Multi-VPK" IsChecked="{Binding MultiVpk}"
                                      Foreground="{StaticResource TextBrush}"
                                      Visibility="{Binding IsVpkPacker, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Pack into multiple chunk files (-M) instead of a single .vpk." />
                            <CheckBox Content="Ignore whitelist warnings" IsChecked="{Binding IgnoreWhitelistWarnings}"
                                      Foreground="{StaticResource TextBrush}"
                                      Visibility="{Binding IsGmodPacker, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Warn about non-whitelisted files and continue instead of failing (-warninvalid)." />
                            <CheckBox Content="Write log to a file" IsChecked="{Binding WriteLogToFile}"
                                      Margin="14,0,0,0" Foreground="{StaticResource TextBrush}"
                                      ToolTip="Also write the packer's console output to a .log file beside the folder." />
                        </StackPanel>

                        <!-- Garry's Mod addon.json (gmad only): title, type and up to two tags, written
                             into the folder before packing so gmad has its metadata. -->
                        <TextBlock Grid.Row="6" Text="Addon" Style="{StaticResource CompileFieldLabel}"
                                   Visibility="{Binding IsGmodPacker, Converter={StaticResource BoolToVis}}" />
                        <Border Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="12,10" CornerRadius="3"
                                Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding IsGmodPacker, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Title" Style="{StaticResource CompileFieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                         Text="{Binding GModTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Addon title (blank uses the folder name)" VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="1" Text="Type" Style="{StaticResource CompileFieldLabel}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          ItemsSource="{Binding GModTypes}" SelectedItem="{Binding SelectedGModType}" />

                                <TextBlock Grid.Row="2" Text="Tags" Style="{StaticResource CompileFieldLabel}"
                                           ToolTip="Choose up to two." />
                                <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding GModTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding IsEnabled}" Margin="0,0,16,4"
                                                      Foreground="{StaticResource TextBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Command preview: full-width, read-only. -->
                        <TextBlock Grid.Row="7" Text="Command" Style="{StaticResource CompileFieldLabel}" />
                        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,12"
                                 Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 Background="{StaticResource BgBrush}" />

                        <!-- Package action + status. -->
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Package" Style="{StaticResource AccentButton}" MinWidth="120"
                                    Padding="16,8" Command="{Binding PackageCommand}" />
                            <Button Content="Cancel" Margin="8,0,0,0" Padding="12,8"
                                    Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsPackaging, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Go to file" Command="{Binding GoToPackageCommand}"
                                    Margin="8,0,0,0" Padding="12,8"
                                    Visibility="{Binding LastPackagePath, Converter={StaticResource StringToVis}}"
                                    ToolTip="{Binding LastPackagePath}" />
                            <Button Content="View Package" Command="{Binding ViewPackageCommand}"
                                    Margin="8,0,0,0" Padding="12,8"
                                    Visibility="{Binding LastPackagePath, Converter={StaticResource StringToVis}}"
                                    ToolTip="Open the packaged file in the Unpack tab to browse its contents." />
                            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                <ProgressBar Width="200" IsIndeterminate="True" HorizontalAlignment="Left"
                                             Visibility="{Binding IsPackaging, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>

                      </Grid>
                    </ScrollViewer>
                  </Border>
                </TabItem>

                <TabItem Header="Advanced" x:Name="PackageAdvancedTab" DataContext="{Binding PackageAdvanced}">
                  <Grid Margin="0,8,0,4">

                    <!-- No project open: prompt to create or open one (shared with the Compile tab). -->
                    <Border Background="{StaticResource PanelGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="Advanced package" FontSize="15" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" />
                          <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                     Margin="0,6,0,14" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap"
                                     Text="Create or open a project (.pw_mdlproject). It's the same project file the Compile tab uses - packaging stores its own entry list inside it." />
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                              <Button Content="New project..." Style="{StaticResource AccentButton}"
                                      Padding="16,8" Command="{Binding NewProjectCommand}" />
                              <Button Content="Open project..." Margin="8,0,0,0" Padding="16,8"
                                      Command="{Binding OpenProjectCommand}" />
                          </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- Project open: bar + settings (top), the entries list fills the rest.
                         Live output goes to the detached console (~). -->
                    <Grid Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}}">
                      <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" MinHeight="160" />
                      </Grid.RowDefinitions>

                      <!-- Project bar: name + path, with New / Open / Close. -->
                      <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                              Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProjectPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Style="{StaticResource MutedText}" ToolTip="{Binding ProjectPath}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="New" Padding="10,4" Command="{Binding NewProjectCommand}" />
                                <Button Content="Open" Margin="6,0,0,0" Padding="10,4" Command="{Binding OpenProjectCommand}" />
                                <Button Content="Close" Margin="6,0,0,0" Padding="10,4" Command="{Binding CloseProjectCommand}" />
                            </StackPanel>
                        </Grid>
                      </Border>

                      <!-- Project settings: game (drives the packer + VTF tool). -->
                      <Border Grid.Row="1" Margin="0,8,0,0" Background="{StaticResource PanelGradientBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <Grid Margin="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Game" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       MinWidth="60" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                      DisplayMemberPath="DisplayName" />
                        </Grid>
                      </Border>

                      <!-- Package entries: header + Add, the reorderable list (fills), and the
                           package-all action bar at the bottom. -->
                      <Border Grid.Row="2" Margin="0,8,0,0" Background="{StaticResource PanelGradientBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <Grid Margin="14,10">
                          <Grid.RowDefinitions>
                              <RowDefinition Height="*" />
                              <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <!-- Master-detail: entries sidebar (left) + selected-entry editor (right),
                               like Game Setup. The sidebar shows just folder name + asset count. -->
                          <Grid Grid.Row="0">
                              <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="340" MinWidth="230" />
                                  <ColumnDefinition Width="8" />
                                  <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>

                              <!-- LEFT: entries list. Add on top; drag the handle to reorder. -->
                              <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                      CornerRadius="3" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="2,2,2,8">
                                        <TextBlock Text="Entries" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Content="+" FontSize="18" FontWeight="Bold" Width="26" Height="26" Padding="0"
                                                HorizontalAlignment="Right" Command="{Binding AddEntryCommand}"
                                                ToolTip="Add a folder to package" />
                                    </Grid>

                                    <ListBox x:Name="PackageEntriesList" Grid.Row="1" ItemsSource="{Binding Entries}"
                                             SelectedItem="{Binding SelectedEntry}" SelectionMode="Extended"
                                             HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                             PreviewMouseLeftButtonDown="PackageEntries_PreviewMouseLeftButtonDown"
                                             DragOver="PackageEntries_DragOver" Drop="PackageEntries_Drop" AllowDrop="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <!-- Highlighting a row (Ctrl/Shift for several) feeds "Package selected". -->
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Drag handle (only this initiates a reorder drag) -->
                                                    <TextBlock Grid.Column="0" Tag="DragHandle" Text="&#x2630;" FontSize="14"
                                                               Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}" Cursor="SizeNS"
                                                               ToolTip="Drag to reorder" />
                                                    <!-- Quick 'Package all' toggle, editable straight from the list. -->
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IncludeInAll}" VerticalAlignment="Center"
                                                              Margin="0,0,8,0" Foreground="{StaticResource TextBrush}"
                                                              ToolTip="Include this entry when 'Package all' runs." />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <!-- Output name, dimmed and smaller in parentheses, only when set. -->
                                                            <TextBlock Text="{Binding OutputName, StringFormat=({0})}" FontSize="11"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding OutputName, Converter={StaticResource StringToVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FolderPath}" Style="{StaticResource MutedText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding AssetSummary}" Style="{StaticResource MutedText}" />
                                                    </StackPanel>
                                                    <!-- Status dot: blue while packaging, red after a failed package. -->
                                                    <Ellipse Grid.Column="3" Width="8" Height="8" Margin="4,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPackaging}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CloneButton}" Command="{Binding CloneCommand}"
                                                                ToolTip="Duplicate this entry." />
                                                        <Button Style="{StaticResource TrashButton}" Command="{Binding RemoveCommand}"
                                                                ToolTip="Remove this entry." />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                              </Border>

                              <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                              <!-- RIGHT: editor for the selected entry. -->
                              <Grid Grid.Column="2">
                                  <TextBlock Text="Select an entry on the left, or click + to add a folder."
                                             Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                  <ContentControl Content="{Binding SelectedEntry}">
                                    <ContentControl.ContentTemplate>
                                      <DataTemplate>
                                        <DataTemplate.Resources>
                                            <Style x:Key="PkgEntryLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="MinWidth" Value="56" />
                                                <Setter Property="Margin" Value="0,0,8,0" />
                                            </Style>
                                        </DataTemplate.Resources>
                                        <!-- Outline: blue while packaging, red if the last package failed. -->
                                        <Border CornerRadius="3" Padding="12" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{StaticResource DangerColor}"
                                                                                      BlurRadius="9" ShadowDepth="0" Opacity="0.7" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPackaging}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{StaticResource AccentColor}"
                                                                                      BlurRadius="9" ShadowDepth="0" Opacity="0.85" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                              <StackPanel>
                                                  <CheckBox Content="Include in &quot;Package all&quot;" Margin="0,0,0,8"
                                                            IsChecked="{Binding IncludeInAll}" Foreground="{StaticResource TextBrush}"
                                                            ToolTip="Include this entry when the bottom 'Package all' button runs." />

                                                  <!-- Name ("Go to file" lives in the bottom action bar). -->
                                                  <Grid>
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Text="Name" Style="{StaticResource PkgEntryLabel}" />
                                                      <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                               Tag="Entry name" VerticalContentAlignment="Center" />
                                                  </Grid>

                                                  <!-- Folder + Browse -->
                                                  <Grid Margin="0,8,0,0">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                          <ColumnDefinition Width="Auto" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Grid.Column="0" Text="Folder" Style="{StaticResource PkgEntryLabel}" />
                                                      <TextBox Grid.Column="1" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                               Tag="Folder to package (relative to the project, or absolute)"
                                                               VerticalContentAlignment="Center" ToolTip="{Binding ResolvedFolderPath}" />
                                                      <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0"
                                                              Command="{Binding BrowseFolderCommand}" />
                                                  </Grid>

                                                  <!-- Output file name override -->
                                                  <Grid Margin="0,8,0,0">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Text="Output" Style="{StaticResource PkgEntryLabel}" />
                                                      <TextBox Grid.Column="1" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"
                                                               Tag="Rename the produced .vpk/.gma to this (extension kept if omitted; overwrites an existing file). Blank keeps the packer's default name."
                                                               VerticalContentAlignment="Center" />
                                                  </Grid>

                                                  <!-- Per-entry packer command -->
                                                  <Grid Margin="0,8,0,0">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto" />
                                                          <ColumnDefinition Width="*" />
                                                      </Grid.ColumnDefinitions>
                                                      <TextBlock Text="Command" Style="{StaticResource PkgEntryLabel}" />
                                                      <TextBox Grid.Column="1" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                                               Tag="Extra packer options for this entry (the .vpk/.gma is written beside the folder)"
                                                               VerticalContentAlignment="Center" />
                                                  </Grid>

                                                  <!-- Pre-assets: transformed + copied into the folder before packing -->
                                                  <Border Margin="0,8,0,0" Background="{StaticResource BgBrush}"
                                                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                          CornerRadius="3" Padding="8">
                                                    <StackPanel>
                                                      <Grid Margin="0,0,0,6">
                                                          <TextBlock Text="Pre-assets" Style="{StaticResource MutedText}"
                                                                     FontWeight="SemiBold" VerticalAlignment="Center" />
                                                          <Button HorizontalAlignment="Right" Content="Add asset" Padding="8,3"
                                                                  Command="{Binding AddAssetCommand}" />
                                                      </Grid>

                                                      <ItemsControl ItemsSource="{Binding Assets}">
                                                        <ItemsControl.ItemTemplate>
                                                          <DataTemplate>
                                                            <!-- Outline: red live whenever this asset would fail (or be skipped) if packaged right now. -->
                                                            <Border CornerRadius="3" Padding="8" Margin="0,0,0,6" BorderThickness="2"
                                                                    ToolTip="{Binding ValidationError}">
                                                              <Border.Style>
                                                                <Style TargetType="Border">
                                                                  <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                                                  <Setter Property="BorderBrush" Value="Transparent" />
                                                                  <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                                      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                                      <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                          <DropShadowEffect Color="{StaticResource DangerColor}"
                                                                                            BlurRadius="9" ShadowDepth="0" Opacity="0.7" />
                                                                        </Setter.Value>
                                                                      </Setter>
                                                                    </DataTrigger>
                                                                  </Style.Triggers>
                                                                </Style>
                                                              </Border.Style>
                                                              <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                  <ColumnDefinition Width="Auto" />
                                                                  <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Thumbnail: the image itself when Kind=Image and the file decodes; otherwise the
                                                                     file's shell icon, small and centered (text assets, undecodable image formats);
                                                                     blank BgBrush when the file is missing. Clicking an image opens it full-size in an
                                                                     ImagePreviewWindow; clicking a text asset opens its raw text in a TextPreviewWindow. -->
                                                                <Border Width="96" Height="96" CornerRadius="2" Margin="0,0,8,0"
                                                                        Background="{StaticResource BgBrush}" VerticalAlignment="Top"
                                                                        MouseLeftButtonUp="AssetThumbnail_Click">
                                                                  <Border.Style>
                                                                    <Style TargetType="Border">
                                                                      <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasImagePreview}" Value="True">
                                                                          <Setter Property="Cursor" Value="Hand" />
                                                                          <Setter Property="ToolTip" Value="Open full-size preview." />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasTextPreview}" Value="True">
                                                                          <Setter Property="Cursor" Value="Hand" />
                                                                          <Setter Property="ToolTip" Value="Open text preview." />
                                                                        </DataTrigger>
                                                                      </Style.Triggers>
                                                                    </Style>
                                                                  </Border.Style>
                                                                  <Image Source="{Binding ThumbnailSource}">
                                                                    <Image.Style>
                                                                      <Style TargetType="Image">
                                                                        <Setter Property="Stretch" Value="UniformToFill" />
                                                                        <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding ThumbnailIsFileIcon}" Value="True">
                                                                            <Setter Property="Stretch" Value="Uniform" />
                                                                            <Setter Property="Width" Value="32" />
                                                                            <Setter Property="Height" Value="32" />
                                                                          </DataTrigger>
                                                                        </Style.Triggers>
                                                                      </Style>
                                                                    </Image.Style>
                                                                  </Image>
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                <!-- Kind + Input + Browse + clone/remove -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="120" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Kind" Style="{StaticResource PkgEntryLabel}" />
                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AssetKinds}"
                                                                              SelectedItem="{Binding SelectedKind}" />
                                                                    <TextBlock Grid.Column="2" Text="Input" Style="{StaticResource PkgEntryLabel}"
                                                                               Margin="10,0,8,0" />
                                                                    <TextBox Grid.Column="3" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                                                             Tag="Source file (relative to the project, or absolute)"
                                                                             VerticalContentAlignment="Center" />
                                                                    <Button Grid.Column="4" Content="Browse..." Margin="6,0,0,0"
                                                                            Command="{Binding BrowseInputCommand}" />
                                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="2,0,0,0">
                                                                        <Button Style="{StaticResource CloneButton}" Command="{Binding CloneCommand}"
                                                                                ToolTip="Duplicate this asset." />
                                                                        <Button Style="{StaticResource TrashButton}" Command="{Binding RemoveCommand}"
                                                                                ToolTip="Remove this asset." />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Output dir + filename -->
                                                                <Grid Margin="0,6,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Out dir" Style="{StaticResource PkgEntryLabel}" />
                                                                    <TextBox Grid.Column="1" Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
                                                                             Tag="Subfolder inside the package folder (blank = folder root; can't escape it)"
                                                                             VerticalContentAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="File" Style="{StaticResource PkgEntryLabel}"
                                                                               Margin="10,0,8,0" />
                                                                    <TextBox Grid.Column="3" Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}"
                                                                             Tag="Output file name (the extension sets the format)"
                                                                             VerticalContentAlignment="Center" />
                                                                </Grid>

                                                                <!-- Image: target format -->
                                                                <Grid Margin="0,6,0,0"
                                                                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="240" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="Convert" Style="{StaticResource PkgEntryLabel}" />
                                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ImageFormats}"
                                                                              SelectedItem="{Binding SelectedImageFormat}" />
                                                                </Grid>

                                                                <!-- VTF: per-asset command override -->
                                                                <Grid Margin="0,6,0,0"
                                                                      Visibility="{Binding IsVtf, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="VTF cmd" Style="{StaticResource PkgEntryLabel}" />
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding VtfCommand, UpdateSourceTrigger=PropertyChanged}"
                                                                             Tag="Extra VTF arguments for this asset - appended after the Game Setup VTF command. Placeholders: {input} {output} {outputdir} {outputname}"
                                                                             VerticalContentAlignment="Center" />
                                                                </Grid>

                                                                <!-- VTF: create a matching .vmt, with an optional template path inline -->
                                                                <Grid Margin="0,6,0,0"
                                                                      Visibility="{Binding IsVtf, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Content="Create VMT" IsChecked="{Binding CreateVmt}"
                                                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                                                              Foreground="{StaticResource TextBrush}"
                                                                              ToolTip="Write a .vmt next to the VTF (same name). Its $basetexture is pointed at this VTF (path under materials/, no extension)." />
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding VmtTemplatePath, UpdateSourceTrigger=PropertyChanged}"
                                                                             Tag="Base .vmt template (relative to the project, or absolute). Its $basetexture is rewritten to this VTF; blank = a minimal VertexLitGeneric material."
                                                                             VerticalContentAlignment="Center"
                                                                             Visibility="{Binding ShowVmtTemplate, Converter={StaticResource BoolToVis}}" />
                                                                    <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0"
                                                                            Command="{Binding BrowseVmtTemplateCommand}"
                                                                            Visibility="{Binding ShowVmtTemplate, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>

                                                                <!-- Text: regex replaces -->
                                                                <StackPanel Margin="0,6,0,0"
                                                                            Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                                                    <Grid Margin="0,0,0,4">
                                                                        <TextBlock Text="Regex replaces" Style="{StaticResource MutedText}"
                                                                                   VerticalAlignment="Center" />
                                                                        <Button HorizontalAlignment="Right" Content="Add regex" Padding="8,2"
                                                                                Command="{Binding AddRegexCommand}" />
                                                                    </Grid>
                                                                    <ItemsControl ItemsSource="{Binding Regexes}">
                                                                      <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                          <Grid Margin="0,0,0,4">
                                                                              <Grid.ColumnDefinitions>
                                                                                  <ColumnDefinition Width="*" />
                                                                                  <ColumnDefinition Width="*" />
                                                                                  <ColumnDefinition Width="Auto" />
                                                                                  <ColumnDefinition Width="Auto" />
                                                                                  <ColumnDefinition Width="Auto" />
                                                                                  <ColumnDefinition Width="Auto" />
                                                                              </Grid.ColumnDefinitions>
                                                                              <TextBox Grid.Column="0" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                                                                       Tag="Find (regex)" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                                                                              <TextBox Grid.Column="1" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}"
                                                                                       Tag="Replace ($1, ${name}...)" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                                                                              <CheckBox Grid.Column="2" Content="Aa" IsChecked="{Binding IgnoreCase}"
                                                                                        VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                                                                        ToolTip="Ignore case" Margin="0,0,8,0" />
                                                                              <CheckBox Grid.Column="3" Content="ML" IsChecked="{Binding Multiline}"
                                                                                        VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                                                                        ToolTip="Multiline (^ and $ match at line breaks)" Margin="0,0,8,0" />
                                                                              <CheckBox Grid.Column="4" Content="Lit" IsChecked="{Binding IsLiteral}"
                                                                                        VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                                                                        ToolTip="Literal - treat the pattern as plain text, not a regex. Use this for tokens like $CHARA$ that contain special characters." Margin="0,0,4,0" />
                                                                              <Button Grid.Column="5" Style="{StaticResource TrashButton}"
                                                                                      Command="{Binding RemoveCommand}" ToolTip="Remove this replace." />
                                                                          </Grid>
                                                                        </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                              </StackPanel>
                                                              </Grid>
                                                            </Border>
                                                          </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                      </ItemsControl>
                                                    </StackPanel>
                                                  </Border>
                                              </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                      </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                  </ContentControl>
                              </Grid>
                          </Grid>

                          <!-- Package all + status, with the terminal toggle on the right. -->
                          <Grid Grid.Row="1" Margin="0,10,0,0">
                              <StackPanel Orientation="Horizontal">
                                  <Button Content="Package all" Style="{StaticResource AccentButton}" MinWidth="120"
                                          Padding="16,8" Command="{Binding PackageAllCommand}"
                                          ToolTip="Package every entry with its 'Package all' box ticked." />
                                  <Button Content="Package selected" MinWidth="120" Margin="8,0,0,0"
                                          Padding="16,8" Command="{Binding PackageSelectedCommand}"
                                          ToolTip="Package the highlighted entries (select several with Ctrl/Shift)." />
                                  <Button Content="Go to file" Margin="8,0,0,0" Padding="12,8"
                                          Command="{Binding SelectedEntry.GoToPackageCommand}"
                                          Visibility="{Binding SelectedEntry.LastPackagePath, Converter={StaticResource StringToVis}}"
                                          ToolTip="{Binding SelectedEntry.LastPackagePath}" />
                                  <Button Content="View Package" Margin="8,0,0,0" Padding="12,8"
                                          Command="{Binding SelectedEntry.ViewPackageCommand}"
                                          Visibility="{Binding SelectedEntry.LastPackagePath, Converter={StaticResource StringToVis}}"
                                          ToolTip="Open the packaged file in the Unpack tab to browse its contents." />
                                  <Button Content="Cancel" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                          Padding="14,8" Command="{Binding CancelCommand}"
                                          Visibility="{Binding IsPackaging, Converter={StaticResource BoolToVis}}" />
                                  <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                                 TextTrimming="CharacterEllipsis" Margin="0,0,0,4" MaxWidth="420" />
                                      <ProgressBar Width="200" IsIndeterminate="True" HorizontalAlignment="Left"
                                                   Visibility="{Binding IsPackaging, Converter={StaticResource BoolToVis}}" />
                                  </StackPanel>
                              </StackPanel>
                          </Grid>
                        </Grid>
                      </Border>
                    </Grid>
                  </Grid>
                </TabItem>

              </TabControl>
            </Grid>
          </TabItem>

          <!-- Textures: a standalone project (.pw_textureproject) that bulk-converts loose images into
               Source .vtf textures, driven by regex/literal patterns matched against a source folder
               (the successor to KitsuneResource's texture pipeline). Reuses Game Setup's VTF tool +
               command. Live output goes to the detached console (~). -->
          <TabItem Header="Textures" x:Name="TexturesTab" DataContext="{Binding Textures}">
            <Grid Margin="0,8,0,4">

              <!-- No project open: prompt to create or open one. -->
              <Border Background="{StaticResource PanelGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="3"
                      Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Textures" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                               Margin="0,6,0,14" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap"
                               Text="Create or open a project (.pw_textureproject). It bulk-converts loose images (PNG/TGA/...) into Source .vtf textures using regex patterns matched against a source folder - like KitsuneResource, driven by your game's VTF tool." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="New project..." Style="{StaticResource AccentButton}"
                                Padding="16,8" Command="{Binding NewProjectCommand}" />
                        <Button Content="Open project..." Margin="8,0,0,0" Padding="16,8"
                                Command="{Binding OpenProjectCommand}" />
                    </StackPanel>
                </StackPanel>
              </Border>

              <!-- Project open: bar + settings (top), the groups list fills the rest. -->
              <Grid Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <!-- Project bar: name + path, with New / Open / Close. -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                        Padding="12,8">
                  <Grid>
                      <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                          <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ProjectPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                     Style="{StaticResource MutedText}" ToolTip="{Binding ProjectPath}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="New" Padding="10,4" Command="{Binding NewProjectCommand}" />
                          <Button Content="Open" Margin="6,0,0,0" Padding="10,4" Command="{Binding OpenProjectCommand}" />
                          <Button Content="Close" Margin="6,0,0,0" Padding="10,4" Command="{Binding CloseProjectCommand}" />
                      </StackPanel>
                  </Grid>
                </Border>

                <!-- Project settings: game (VTF tool + command), source folder, options, global command. -->
                <Border Grid.Row="1" Margin="0,8,0,0" Background="{StaticResource PanelGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                  <StackPanel Margin="14,12">
                      <Grid>
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Game" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                     MinWidth="70" Margin="0,0,12,0" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                    DisplayMemberPath="DisplayName" />
                      </Grid>

                      <!-- Source folder + Browse -->
                      <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Source" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                     MinWidth="70" Margin="0,0,12,0" />
                          <TextBox Grid.Column="1" Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                                   Tag="Folder scanned for input images (relative to the project, or absolute; blank = the project folder)"
                                   VerticalContentAlignment="Center" ToolTip="{Binding ResolvedSourceFolder}" />
                          <TextBlock Grid.Column="2" Text="missing" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Foreground="{StaticResource LightDangerBrush}"
                                     ToolTip="The resolved source folder doesn't exist on disk."
                                     Visibility="{Binding SourceFolderMissing, Converter={StaticResource BoolToVis}}" />
                          <Button Grid.Column="3" Content="Browse..." Margin="6,0,0,0"
                                  Command="{Binding BrowseSourceCommand}" />
                      </Grid>

                      <!-- Global VTF command -->
                      <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="VTF cmd" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                     MinWidth="70" Margin="0,0,12,0" />
                          <TextBox Grid.Column="1" Text="{Binding GlobalVtfCommand, UpdateSourceTrigger=PropertyChanged}"
                                   Tag="Extra VTF arguments applied to every group (after the Game Setup VTF command). Placeholders: {input} {output} {outputdir} {outputname}"
                                   VerticalContentAlignment="Center" />
                      </Grid>

                      <CheckBox Content="Skip files already up-to-date (output newer than source)" Margin="0,10,0,0"
                                IsChecked="{Binding SkipUpToDate}" Foreground="{StaticResource TextBrush}"
                                ToolTip="Incremental runs: skip a file whose .vtf already exists and is newer than its source. 'Force' below overrides this per run." />
                  </StackPanel>
                </Border>

                <!-- Groups: master-detail (list + selected-group editor) and the convert action bar. -->
                <Border Grid.Row="2" Margin="0,8,0,0" Background="{StaticResource PanelGradientBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                  <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" MinWidth="230" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: groups list. Add on top; drag the handle to reorder. -->
                        <Border Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="8">
                          <Grid>
                              <Grid.RowDefinitions>
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="*" />
                              </Grid.RowDefinitions>
                              <Grid Grid.Row="0" Margin="2,2,2,8">
                                  <TextBlock Text="Groups" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  <Button Content="+" FontSize="18" FontWeight="Bold" Width="26" Height="26" Padding="0"
                                          HorizontalAlignment="Right" Command="{Binding AddGroupCommand}"
                                          ToolTip="Add a texture group" />
                              </Grid>

                              <ListBox x:Name="TextureGroupsList" Grid.Row="1" ItemsSource="{Binding Groups}"
                                       SelectedItem="{Binding SelectedGroup}" SelectionMode="Extended"
                                       HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                       PreviewMouseLeftButtonDown="TextureGroups_PreviewMouseLeftButtonDown"
                                       DragOver="TextureGroups_DragOver" Drop="TextureGroups_Drop" AllowDrop="True"
                                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                  <ListBox.ItemContainerStyle>
                                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                      </Style>
                                  </ListBox.ItemContainerStyle>
                                  <ListBox.ItemTemplate>
                                      <DataTemplate>
                                          <Grid Margin="2,8">
                                              <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="Auto" />
                                                  <ColumnDefinition Width="Auto" />
                                                  <ColumnDefinition Width="*" />
                                                  <ColumnDefinition Width="Auto" />
                                                  <ColumnDefinition Width="Auto" />
                                              </Grid.ColumnDefinitions>
                                              <!-- Drag handle (only this initiates a reorder drag) -->
                                              <TextBlock Grid.Column="0" Tag="DragHandle" Text="&#x2630;" FontSize="14"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource MutedTextBrush}" Cursor="SizeNS"
                                                         ToolTip="Drag to reorder" />
                                              <!-- Quick 'Convert all' toggle, editable straight from the list. -->
                                              <CheckBox Grid.Column="1" IsChecked="{Binding IncludeInAll}" VerticalAlignment="Center"
                                                        Margin="0,0,8,0" Foreground="{StaticResource TextBrush}"
                                                        ToolTip="Include this group when 'Convert all' runs." />
                                              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                             TextTrimming="CharacterEllipsis" />
                                                  <TextBlock Text="{Binding PatternSummary}" Style="{StaticResource MutedText}"
                                                             TextTrimming="CharacterEllipsis" />
                                              </StackPanel>
                                              <!-- Status dot: blue while converting, red after a failure / invalid regex. -->
                                              <Ellipse Grid.Column="3" Width="8" Height="8" Margin="4,0" VerticalAlignment="Center">
                                                  <Ellipse.Style>
                                                      <Style TargetType="Ellipse">
                                                          <Setter Property="Visibility" Value="Collapsed" />
                                                          <Style.Triggers>
                                                              <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                  <Setter Property="Visibility" Value="Visible" />
                                                                  <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                              </DataTrigger>
                                                              <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                                                  <Setter Property="Visibility" Value="Visible" />
                                                                  <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                              </DataTrigger>
                                                          </Style.Triggers>
                                                      </Style>
                                                  </Ellipse.Style>
                                              </Ellipse>
                                              <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                  <Button Style="{StaticResource CloneButton}" Command="{Binding CloneCommand}"
                                                          ToolTip="Duplicate this group." />
                                                  <Button Style="{StaticResource TrashButton}" Command="{Binding RemoveCommand}"
                                                          ToolTip="Remove this group." />
                                              </StackPanel>
                                          </Grid>
                                      </DataTemplate>
                                  </ListBox.ItemTemplate>
                              </ListBox>
                          </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- RIGHT: editor for the selected group. -->
                        <Grid Grid.Column="2">
                            <TextBlock Text="Select a group on the left, or click + to add one."
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                            <ContentControl Content="{Binding SelectedGroup}">
                              <ContentControl.ContentTemplate>
                                <DataTemplate>
                                  <DataTemplate.Resources>
                                      <Style x:Key="TexLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                          <Setter Property="VerticalAlignment" Value="Center" />
                                          <Setter Property="MinWidth" Value="64" />
                                          <Setter Property="Margin" Value="0,0,8,0" />
                                      </Style>
                                  </DataTemplate.Resources>
                                  <!-- Outline: blue while converting, red if the last run failed or the regex is invalid. -->
                                  <Border CornerRadius="3" Padding="12" BorderThickness="2" ToolTip="{Binding ValidationError}">
                                      <Border.Style>
                                          <Style TargetType="Border">
                                              <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                              <Setter Property="BorderBrush" Value="Transparent" />
                                              <Style.Triggers>
                                                  <DataTrigger Binding="{Binding HasError}" Value="True">
                                                      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                      <Setter Property="Effect">
                                                          <Setter.Value>
                                                              <DropShadowEffect Color="{StaticResource DangerColor}"
                                                                                BlurRadius="9" ShadowDepth="0" Opacity="0.7" />
                                                          </Setter.Value>
                                                      </Setter>
                                                  </DataTrigger>
                                                  <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                      <Setter Property="Effect">
                                                          <Setter.Value>
                                                              <DropShadowEffect Color="{StaticResource AccentColor}"
                                                                                BlurRadius="9" ShadowDepth="0" Opacity="0.85" />
                                                          </Setter.Value>
                                                      </Setter>
                                                  </DataTrigger>
                                              </Style.Triggers>
                                          </Style>
                                      </Border.Style>
                                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <CheckBox Content="Include in &quot;Convert all&quot;" Margin="0,0,0,8"
                                                      IsChecked="{Binding IncludeInAll}" Foreground="{StaticResource TextBrush}"
                                                      ToolTip="Include this group when the bottom 'Convert all' button runs." />

                                            <!-- Name -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Name" Style="{StaticResource TexLabel}" />
                                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Group name" VerticalContentAlignment="Center" />
                                            </Grid>

                                            <!-- Pattern + regex/recursive toggles -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Pattern" Style="{StaticResource TexLabel}" />
                                                <TextBox Grid.Column="1" Text="{Binding InputPattern, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Matched against each file's name. Regex (e.g. \.(png|tga)$) or plain text."
                                                         VerticalContentAlignment="Center" FontFamily="Consolas"
                                                         ToolTip="{Binding ValidationError}" />
                                                <ToggleButton Grid.Column="2" Content=".*" Margin="6,0,0,0" Padding="8,4"
                                                              IsChecked="{Binding IsRegex}" ToolTip="Treat the pattern as a regex (off = plain case-insensitive substring)." />
                                                <ToggleButton Grid.Column="3" Content="Sub" Margin="6,0,0,0" Padding="8,4"
                                                              IsChecked="{Binding Recursive}" ToolTip="Search sub-folders recursively." />
                                            </Grid>

                                            <!-- Output dir + Browse -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Output" Style="{StaticResource TexLabel}" />
                                                <TextBox Grid.Column="1" Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Where .vtf files go, relative to the source folder (blank = beside each source; otherwise the tree is mirrored here). Can't escape the source folder."
                                                         VerticalContentAlignment="Center" />
                                                <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0"
                                                        Command="{Binding BrowseOutputCommand}" />
                                            </Grid>

                                            <!-- Per-group VTF command -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="VTF cmd" Style="{StaticResource TexLabel}" />
                                                <TextBox Grid.Column="1" Text="{Binding VtfCommand, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Extra VTF arguments for this group (after the game + global command). Placeholders: {input} {output} {outputdir} {outputname}"
                                                         VerticalContentAlignment="Center" FontFamily="Consolas" />
                                            </Grid>
                                        </StackPanel>
                                      </ScrollViewer>
                                  </Border>
                                </DataTemplate>
                              </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </Grid>

                    <!-- Convert all / selected + status, with a Force toggle. -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Convert all" Style="{StaticResource AccentButton}" MinWidth="120"
                                    Padding="16,8" Command="{Binding ConvertAllCommand}"
                                    ToolTip="Convert every group with its 'Convert all' box ticked." />
                            <Button Content="Convert selected" MinWidth="120" Margin="8,0,0,0"
                                    Padding="16,8" Command="{Binding ConvertSelectedCommand}"
                                    ToolTip="Convert the highlighted groups (select several with Ctrl/Shift)." />
                            <Button Content="Cancel" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                    Padding="14,8" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}" />
                            <CheckBox Content="Force" IsChecked="{Binding Force}" VerticalAlignment="Center"
                                      Margin="12,0,0,0" Foreground="{StaticResource TextBrush}"
                                      ToolTip="Reconvert even files that are already up-to-date (this run only)." />
                            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,4" MaxWidth="420" />
                                <ProgressBar Width="200" IsIndeterminate="True" HorizontalAlignment="Left"
                                             Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </TabItem>

          <!-- Model View: a Crowbar-style "View in HLMV". Launches Game Setup's configured model
               viewer on a chosen .mdl (passing -game gameinfoDir so materials resolve) and shows the
               ModelTool info summary for it in a read-only box. No embedded viewer. -->
          <TabItem Header="Model View" x:Name="ModelViewTab" DataContext="{Binding ModelView}">
            <Grid Margin="0,8,0,4">
              <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" MinHeight="120" />
              </Grid.RowDefinitions>
              <Grid.Resources>
                <Style x:Key="ModelViewFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="MinWidth" Value="60" />
                    <Setter Property="Margin" Value="0,0,12,0" />
                </Style>
              </Grid.Resources>

              <!-- Settings: game (model viewer + gameinfo), the .mdl to view, and the action bar. -->
              <Border Grid.Row="0" Background="{StaticResource PanelGradientBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="3">
                <StackPanel Margin="14,12">
                    <!-- Game: full-width dropdown (from the Game Setup roster). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Game" Style="{StaticResource ModelViewFieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                  DisplayMemberPath="DisplayName" />
                    </Grid>

                    <!-- Resolved model viewer + gameinfo paths (with "missing" warnings). -->
                    <Grid Margin="72,6,0,0"
                          Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Viewer" Style="{StaticResource MutedText}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedGame.ModelViewer.ResolvedPath}"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}"
                                   ToolTip="{Binding SelectedGame.ModelViewer.ResolvedPath}" />
                        <TextBlock Grid.Column="2" Text="missing" Margin="8,0,0,0"
                                   Foreground="{StaticResource LightDangerBrush}"
                                   ToolTip="The model viewer path doesn't exist - set it in Game Setup."
                                   Visibility="{Binding SelectedGame.ModelViewer.PathMissing, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Row="1" Text="GameInfo" Style="{StaticResource MutedText}" Margin="0,3,10,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGame.GameInfo.ResolvedPath}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}"
                                   ToolTip="{Binding SelectedGame.GameInfo.ResolvedPath}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="missing" Margin="8,3,0,0"
                                   Foreground="{StaticResource LightDangerBrush}"
                                   ToolTip="The gameinfo.txt path doesn't exist - set it in Game Setup. Without it the viewer may not find the model's materials."
                                   Visibility="{Binding SelectedGame.GameInfo.PathMissing, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- Model (.mdl): full-width path + Browse. -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Model" Style="{StaticResource ModelViewFieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding MdlPath, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Type or paste a compiled .mdl path" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0"
                                Command="{Binding BrowseMdlCommand}" />
                    </Grid>

                    <!-- Action bar: open in viewer + status. -->
                    <Grid Margin="72,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open in viewer" Style="{StaticResource AccentButton}" MinWidth="120"
                                    Padding="16,8" Command="{Binding OpenInViewerCommand}"
                                    ToolTip="Load the .mdl in the viewer. A model inside the game folder is first copied (with its .vvd/.vtx/.phy siblings, not materials) to a temp folder so it opens via HLMV's crash-free direct load; textures come from the viewer's own game mount." />
                            <Button Content="Go to file" Command="{Binding GoToMdlCommand}"
                                    Margin="8,0,0,0" Padding="12,8"
                                    Visibility="{Binding MdlPath, Converter={StaticResource StringToVis}}"
                                    ToolTip="{Binding MdlPath}" />
                            <Button Content="Refresh info" Command="{Binding RefreshInfoCommand}"
                                    Margin="8,0,0,0" Padding="12,8"
                                    ToolTip="Re-read the model's stats with ModelTool." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                            <ProgressBar Width="200" IsIndeterminate="True" HorizontalAlignment="Left"
                                         Visibility="{Binding IsLoadingInfo, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Hint when no viewer is configured for the selected game. -->
                    <TextBlock Margin="72,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Foreground="{StaticResource LightDangerBrush}"
                               Text="No model viewer is set for this game. Configure one (e.g. hlmv.exe) in Game Setup to enable 'Open in viewer'."
                               Visibility="{Binding HasModelViewer, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
              </Border>

              <!-- Model info: the ModelTool summary for the current .mdl (empty until a model loads);
                   the box fills the remaining space and scrolls when the text overflows. -->
              <Grid Grid.Row="1" Margin="0,10,0,0">
                  <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Model info" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                  <TextBox Grid.Row="1" Text="{Binding ModelInfo, Mode=OneWay}" IsReadOnly="True"
                           TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
              </Grid>
            </Grid>
          </TabItem>

          <!-- About: developer + app info, Steam-style profile card. -->
          <TabItem Header="About">
            <ScrollViewer x:Name="AboutScroll" VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
              <Border Background="{StaticResource PanelGradientBrush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                      CornerRadius="3" Padding="24" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Margin="0"
                      MinHeight="{Binding ViewportHeight, ElementName=AboutScroll}">
                <StackPanel>
                    <!-- Developer: circular avatar + name + SteamID, like the Steam profile header. -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="96" Height="96" CornerRadius="48"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Clip>
                                <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" />
                            </Border.Clip>
                            <Grid>
                                <!-- Placeholder initial behind the image (shows until/if the avatar loads). -->
                                <TextBlock Text="{Binding DeveloperName, Converter={StaticResource FirstLetter}}"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="40"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Stretch="UniformToFill"
                                       Source="{Binding DeveloperAvatarUrl, TargetNullValue={x:Null}}"
                                       Visibility="{Binding DeveloperAvatarUrl, Converter={StaticResource StringToVis}}" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Developer" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding DeveloperName}" FontSize="26" FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                            <Button Content="GitHub" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Padding="12,4" Click="OpenDeveloperGitHub_Click"
                                    ToolTip="Open the developer's GitHub." />
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,18" />

                    <!-- App description + version -->
                    <TextBlock Text="PulseWorkshop" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppVersionDisplay}" Style="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding AppDescription}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" LineHeight="20" />
                    <Button Content="KitsuneResource" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Padding="12,4" Click="OpenKitsuneResource_Click"
                            ToolTip="Open the predecessor project, KitsuneResource, on GitHub." />
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>
        </TabControl>

    </Grid>
</Window>
